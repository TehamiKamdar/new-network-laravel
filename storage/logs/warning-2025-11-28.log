[2025-11-28 21:50:32] production.INFO: {"id":0,"publisher_id":"ebbf62c5-ae46-4b24-8b40-2c15d8143c97","website_id":"3fb8982d-b3c5-48b2-b7a0-21073be3d08e","advertiser_id":"923f5e2f-5b2a-43fa-a3af-58aa2f178a37","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=20296&awinaffid=1263017&campaign=FINN+DE&clickref=ebbf62c5-ae46-4b24-8b40-2c15d8143c97&clickref2=3fb8982d-b3c5-48b2-b7a0-21073be3d08e&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.finn.com%2Fde-DE%2Fsubscribe%2Fbmw&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/O1SmCvtO","tracking_url_long":null,"sub_id":null,"hits":56,"unique_visitor":52,"advertiser":{"id":"923f5e2f-5b2a-43fa-a3af-58aa2f178a37","user_id":null,"network_source_id":null,"advertiser_id":20296,"api_advertiser_id":"923f5e2f-5b2a-43fa-a3af-58aa2f178a37","sid":89426403,"name":"FINN DE","currency_code":"EUR","average_payment_time":"105","validation_days":"3","epc":"0.56","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/finnde.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/20296.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"5","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["Germany"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["DE"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["*.finn.auto","stg-finn-auto.now.sh","*.finn.com","finn.com","www.finn.com"],"short_description":"Mit FINN fahren unsere Kunden flexibel Auto im Rundum-Sorglos Abo. Im monatlichen Fixpreis ist alles enthalten au\u00dfer Tanken. Die Bestellung erfolgt online und das Fahrzeug wird bis zur Haust\u00fcr geliefert - ganz ohne Papierkram.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">FINN DE Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">FINN | Das Rundum-Sorglos Auto Abo<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Mit FINN&nbsp;fahren unsere Kunden Auto im Rundum-Sorglos Abo zum monatlichen Fixpreis.&nbsp;Dabei bleiben sie stets flexibel mit Abolaufzeiten ab 1 Monat - und das ohne l\u00e4stigen Papierkram. Denn um die Anmeldung, Versicherung, Instandhaltung, etc. k\u00fcmmern wir uns.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Wir m\u00f6chten Auto fahren so einfach machen wie Online-Shopping: Die Buchung erfolgt online und nach der Auswahl des Wunschtermins kann das Auto&nbsp;bequem an der Haust\u00fcr empfangen werden&nbsp;- und das deutschlandweit kostenlos.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Den CO2-Aussto\u00df unserer Autos kompensieren wir \u00fcber ausgew\u00e4hlte Klimaprojekte.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Provisionen<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">240\u20ac Standardprovision&nbsp;<\/span>pro Kauf (gilt nur f\u00fcr Neukunden)<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">400\u20ac Sonderprovisionen f\u00fcr ausgew\u00e4hlte Modelle (Die special car Provisionen werden in unserem Newsletter bekannt gegeben.&nbsp;<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Warum Sie Teil unseres Partnerprogramms werden sollten<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Attraktive Provision von 240\u20ac pro Kauf (gilt nur f\u00fcr Neukunden)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Pers\u00f6nlicher Ansprechpartner<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Innovatives Konzept<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Produktdatenliste<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Gro\u00dfe Auswahl an Werbemitteln in allen g\u00e4ngigen Gr\u00f6\u00dfen - auf R\u00fcckfrage stellen wir gerne gesonderte Werbemittel zur Verf\u00fcgung<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Warum unsere Kunden das&nbsp;FINN&nbsp;Abo sch\u00e4tzen<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Alles inklusive au\u00dfer tanken<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Flexibilit\u00e4t gegen\u00fcber Leasing und Autokauf<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Kostenlose Haust\u00fcrlieferung<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Monatliche Rate ohne Anzahlung oder versteckte Kosten<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">In unter 10 Minuten online bestellen<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Klimaneutral Auto fahren<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Unsere Zielgruppe<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">44% der Kunden sind zwischen 30 und 49 Jahren alt, w\u00e4hrend das Durchschnittsalter 43 Jahre betr\u00e4gt<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">28%&nbsp;der Kunden wohnen in gr\u00f6\u00dferen (&gt;= 500k Einwohner) und 72% in kleineren&nbsp;(&lt; 500k Einwohner) St\u00e4dten<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Die beliebtesten Auto Kategorien sind Kompakt-SUV, Kleinwagen, Mittelklassewagen und Mittelklasse-SUV<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Die beliebteste&nbsp;Abo Dauer betr\u00e4gt 12 Monate w\u00e4hrend 6 und 13 Monate ebenfalls sehr beliebt sind<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Die beliebtesten Antriebsarten sind Benzin und Elektro&nbsp;<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">50% der Kunden nutzen das 1000 Kilometer Paket<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Das Nettoeinkommen liegt meist zwischen 30.000\u20ac und 60.000\u20ac<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Um ein Abo abzuschlie\u00dfen muss der Kunde<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">eine deutsche Meldeadresse haben<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">zwischen 18 und 75 Jahre alt sein (Fahrer:innen unter 23 Jahren k\u00f6nnen Fahrzeuge mit einer Fahrleistung unter 150 kW oder 203 PS buchen)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">bei Bestellung einen in der EU g\u00fcltigen F\u00fchrerschein besitzen, der \u00fcber den Abo-Zeitraum nicht abl\u00e4uft&nbsp;<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">im Besitz eines g\u00fcltigen Ausweisdokuments sein&nbsp;<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">seit mindestens zwei Jahren durchg\u00e4ngig im Besitz der Fahrerlaubnis Klasse B (alte Klasse 3) sein<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">im Verlauf der Bestellung die Verifikation mit den relevanten Dokumenten (F\u00fchrerschein und Personalausweis) durchf\u00fchren<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Die SEA Richtlinien verbieten einen Gebrauch der Marke FINN. Bitte buchen Sie \u201eFINN\u201c als Negativ-Keyword in Ihre Kampagnen ein.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Kontakt<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">sarthak.oak@finn.auto&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">partnerships@finn.auto<\/p><\/div>","program_policies":"<p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Allgemeine Gesch\u00e4ftsbedingungen<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Die Teilnahme am Partnerprogramm kommt mit der Best\u00e4tigung der Bewerbung des Partners durch uns zustande und kann von beiden Seiten ohne Angabe von Gr\u00fcnden jederzeit beendet werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Partner mit rechtswidrigen, politischen, gewaltverherrlichenden, pornographischen oder illegalen Inhalten sind grunds\u00e4tzlich von der Teilnahme am Partnerprogramm ausgeschlossen. Zudem behalten wir uns als Advertiser vor, die Kooperation sofort zu beenden, falls von uns bereitgstellte Werbemittel auf dieser Art von Websites eingebunden werden. Daraus m\u00f6glicherweise resultierende Transaktionen werden von uns abgelehnt und ein Provisionsanspruch entf\u00e4llt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Wir kooperieren ausschlie\u00dflich mit Publishern, die auf ihren Werbefl\u00e4chen ein valides Impressum angeben.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Websites, die sich noch im Aufbau befinden oder Fehler erzeugen, sind von einer Teilnahme am Partnerprogramm ausgeschlossen.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Partner des Advertiser Programs m\u00fcssen in jedem Fall voll gesch\u00e4ftsf\u00e4hig sein.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Die Provision wird nicht f\u00fcr die Vermittlung von Kunden ausgezahlt, die beim Bestellabschluss einen durch eine andere Quelle erhaltenen Gutscheincode verwenden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Die Provision wird lediglich f\u00fcr die Vermittlung von Neukunden ausgezahlt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Werbemittel<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Es ist ausschlie\u00dflich die Verwendung der Werbemittel erlaubt, welche \u00fcber das Partnernetzwerk zur Verf\u00fcgung gestellt werden. Eine Ver\u00e4nderung oder Erweiterung der bereitgestellten Werbemittel ist ohne die vorherige Einwilligung des Advertisers nicht zul\u00e4ssig.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Des Weiteren d\u00fcrfen besagte Werbemittel ausnahmlos nur auf den bei der Anmeldung zum Programm registrierten Werbefl\u00e4chen eingesetzt werden.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Der Publisher ist f\u00fcr die Aktualit\u00e4t der Werbemittel verantwortlich und verpflichtet sich, Werbemittel unverz\u00fcglich von der Website zu entfernen, wenn er vom Advertiser darauf hingewiesen wird, oder er Grund zur Annahme hat, dass besagtes Werbemittel nicht weiter verwendet werden darf.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Der Publisher erh\u00e4lt \u00fcber das Netzwerk die Erlaubnis, f\u00fcr die Dauer der Kooperation mit dem Advertiser Programm die bereitgstellten Werbemittel zu nutzen. Wird die Zusammenarbeit beendet, d\u00fcrfen auch die Werbemittel nicht l\u00e4nger vom Publisher verwendet werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">In Absprache mit dem Advertiser k\u00f6nnen inidviduelle Werbemittel erstellt werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Produktdaten<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Es ist nicht gestattet, den vom Advertiser bereitgestellten Produktdatanfeed au\u00dferhalb der eigenen Website auf&nbsp;Drittplattformen wie z.B. Google Shopping zu verwenden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Der Publisher tr\u00e4gt daf\u00fcr Sorge, stets die aktuellste Version des vom Advertiser angebotenen Produktdatenfeeds f\u00fcr seine Werbet\u00e4tigkeit zu nutzen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Browser-Plugins\/Werbung \u00fcber Spy-\/Adware<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Die Kombination von Werbemittel-Sourcecodes zur Erstellung von Plugins f\u00fcr jegliche Browser (z.B. Hotbars, Toolbars) sowie Werbung \u00fcber Adware oder Spyware ist nicht erlaubt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">F\u00fcr eventuelle R\u00fcckfragen oder Anliegen stehen wir gern zur Verf\u00fcgung.<\/p>","url":"https:\/\/www.finn.com\/de-DE","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=20296&id=1263017","type":"api","created_at":"2023-03-21T07:05:37.000000Z","updated_at":"2025-11-17T10:43:39.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":1,"custom_domain":"finn.com"}}  
