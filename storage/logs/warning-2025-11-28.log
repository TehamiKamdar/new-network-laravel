sion<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">\u00a350&nbsp;AOV<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">30-day returns and 60-day validation window<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">4% flat commission rate.<\/li><\/ul>","url":"https:\/\/jansport.de\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=56889&id=1263017","type":"api","created_at":"2023-08-11T19:08:35.000000Z","updated_at":"2025-08-09T10:44:33.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":0,"custom_domain":"jansport.de"}}  
