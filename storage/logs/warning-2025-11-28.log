[2025-11-28 21:16:31] production.INFO: {"id":442,"publisher_id":"2cb22ca9-2da4-4e79-b499-e6f042a55fae","website_id":"78471f46-3aea-4178-98be-23952feb2804","advertiser_id":"c893c353-9c63-4c81-99f6-3bea66cf089a","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=42931&awinaffid=1263017&campaign=BRVN+by+Bravian&clickref=2cb22ca9-2da4-4e79-b499-e6f042a55fae&clickref2=78471f46-3aea-4178-98be-23952feb2804&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fbravian.eu%2Fen-gb%2Fcollections%2Ft-shirts%2Fproducts%2Ft-shirt-paralell-universe&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/kYKICFBT","tracking_url_long":null,"sub_id":null,"hits":10,"unique_visitor":8,"advertiser":{"id":"c893c353-9c63-4c81-99f6-3bea66cf089a","user_id":null,"network_source_id":null,"advertiser_id":42931,"api_advertiser_id":"c893c353-9c63-4c81-99f6-3bea66cf089a","sid":24745039,"name":"BRVN by Bravian","currency_code":"GBP","average_payment_time":"","validation_days":"22","epc":"2.65","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/brvnbybravian.png","fetch_logo_url":null,"is_fetchable_logo":0,"fetch_logo_error":null,"status":0,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"8","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":0,"country_full_name":["United Kingdom"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["bravian.eu","*.bravian.eu"],"short_description":"BRVN makes menswear responsibly, through the use of certified materials, small-scale manufacturing and comprehensive recycling strategies.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">BRVN by Bravian Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>WELCOME TO THE BRVN AFFILIATE PROGRAMME&nbsp;<\/b><\/span><\/p><h6 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\"><span style=\"margin: 0px; padding: 0px;\">BRVN<\/span>&nbsp;redefines technical clothing, championing innovative design informed by utilitarian tradition.<\/h6><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Inspired by bravery,&nbsp;<span style=\"margin: 0px; padding: 0px;\">BRVN<\/span>&nbsp;represents The Fearless. The Untamed. The Expressive. With authenticity at the forefront of our values, we hero individuality through versatile, trend-led pieces for the adventurous spirit.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Born from The Latino Group, established pioneers of military uniform and technical workwear since 1986, we continue to recruit the progressive design techniques of our founders.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">The&nbsp;<span style=\"margin: 0px; padding: 0px;\">BRVN<\/span>&nbsp;concept inherits this established knowledge of techwear and pairs it with a bold creative vision. The result is expertly crafted, highly durable performance clothing with a playful fashion authority.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We are dedicated to offering premium, sustainably conscious products.&nbsp;<span style=\"margin: 0px; padding: 0px;\">BRVN<\/span>&nbsp;makes clothes responsibly, through the use of certified materials, small-scale manufacturing and comprehensive recycling strategies. All while providing consistently superior quality.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Brave fashion, built to last.<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>THE BENEFITS OF JOINING OUR PROGRAMME<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We offer an 8% commission with a 30-day cookie as standard. This means that if any of your website users or blog readers purchase from BRVN via your affiliate link within 30 days of clicking, you automatically earn an 8% commission for each sale, providing the order wasn't cancelled, returned or attributed to another marketing channel.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>We also provide you with the following:&nbsp;<\/b><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Fresh content on a regular basis<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Regular newsletters to keep you up to date with all our promotions<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Voucher codes when needed for promotions and offers<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Up-to-date creatives, both static and dynamic<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">14-day returns period<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Free worldwide shipping<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Free returns<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>AS AN AFFILIATE, WHAT CAN YOU DO?<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">As part of our affiliate programme, we ask you to promote BRVN on your site or blog by:<\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Placing our ads, banners and links on your site<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Accessing our product feed and promoting our pieces to your visitors, ensuring they are informed on our latest collections and offerings.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>HOW TO JOIN<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">If you wish to join the BRVN affiliate community, simply apply to our programme via AWIN. Our dedicated team will then take a look at your website or blog, to ensure it is suitable for, and in line with, our brand. We will then be in contact to let you know if your application has been successful.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Feel free to contact&nbsp;<a href=\"mailto:emma.swingewood@thelifestyle-agency.com\" style=\"margin: 0px; padding: 0px; cursor: pointer; transition-property: color; transition-duration: 0.2s;\">emma.swingewood@thelifestyle-agency.com<\/a>&nbsp;for partnership opportunities and if you are facing any problems.&nbsp;<\/p><\/div>","program_policies":"<p><span style=\"margin: 0px; padding: 0px;\">AFFILIATE AGREEMENT \u2013 TERMS &amp; CONDITIONS<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">By participating in the BRVN&nbsp;Affiliate program through AWIN, you agree with the supplemental Program terms and conditions. The terms \u201cAffiliate,\u201d \u201cyou,\u201d and \u201cyour\u201d are referring to you, the applicant. \u201cWe\u201d and \u201cour\u201d refer to the BRVN Affiliate Program.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We are independent parties and this agreement does not form any partnership.<br style=\"margin: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">AGREEMENT DURATION<\/span><br style=\"margin: 0px; padding: 0px;\">This agreement will commence upon our acceptance of your affiliate application and will end when terminated by either party.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Termination may happen at any time, with or without cause, by giving the other party written notice of termination.<br style=\"margin: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">MODIFICATION<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We may modify any of the terms and conditions within this Agreement at any time and at our sole discretion. Affiliates will be notified of any change in advance. Modifications may relate, but are not limited, to commission rates and payment.<br style=\"margin: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">COMMISSION<\/span>&nbsp;<span style=\"margin: 0px; padding: 0px;\">RATES<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">You will receive a published % of the revenue per sale as a commission from orders placed through your Affiliate Site.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">For a sale to generate a commission to an Affiliate, the customer must complete all stages of the order process and the customer\u2019s payment must be received. Affiliate commissions will only be paid on sales which are made through qualified Affiliates.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Commission will be paid upon validation of each transaction and may take up to 30 days to process. Any chargebacks or fees from a returned or cancelled order will be adjusted in the following fee payment.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">BIDDING TERMS<\/span><br style=\"margin: 0px; padding: 0px;\">You shall not purchase or register search engine keywords, Pay Per Click advertising, and domain names employing the term \u2018BRVN by Bravian' or variations thereof.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">If the BRVN&nbsp;Affiliate Program determines that you have not acted in accordance with these terms, then we may remove you from the BRVN Affiliate Program with immediate effect. Please note too that any unusual activity that may point towards Affiliate fraud will be duly investigated.<br style=\"margin: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>TRACKING TAGS<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">The tools, products and creative assets (collectively, \"Assets\") provided to you by BRVN provide valuable information vital to the success of the Program, including information that ensures generated Affiliate Transactions are properly attributed to each Affiliate for Payout calculations. Therefore, these Assets must be used in their intended manner. You agree that you will not corrupt, modify or disable the tracking functionality provided to you related to the Program.<br style=\"margin: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>ORDER PROCESSING<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">BRVN will be solely responsible for processing every order placed by a customer via Affiliate sites. Customers who purchase products and services through&nbsp;BRVN will be deemed to be customers of&nbsp;BRVN. We reserve the right to change the prices of our products at any time, and availability of stock may vary from time to time. The BRVN policies will always determine the price paid by the customer. We reserve the right to reject any order that does not comply with our rules, operating procedures and policies.<br style=\"margin: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>WEBSITE RESTRICTIONS<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">BRVN reserves the right not to accept any site into the BRVN Affiliate Program based on site content. Sites that Do Not Qualify for the Program include sites that:<\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Promote X-rated and sexually explicit materials<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Promote violence and discord<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Promote discrimination based on race, sex, religion, nationality, disability, sexual orientation, or age<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Promote illegal or questionable activities<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Violate intellectual property rights<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">SPAM (UCE) \u2013 BRVN in no way participates in mass unsolicited e-mailing (i.e. spamming), and all Affiliates are expected to adhere to this policy as well. Violation of this policy will result in the termination of this contract and immediate dismissal from the BRVN Affiliate Program, with no refund.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>PPC POLICY<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">With the exception of the company brand name and misspellings, we allow PPC activity. For any paid search activity we would ask affiliates to add negative matches against 'BRVN'&nbsp;or \u2018BRVN by Bravian\u2019 company brand terms or variations thereof.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>VOUCHER CODE POLICY<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please note that affiliates may only use voucher codes that are available through the BRVN affiliate programme, or those that have been issued directly by AWIN. Where an affiliate is found promoting a code that has no