[2025-11-28 21:05:10] production.INFO: {"id":0,"publisher_id":"ebbf62c5-ae46-4b24-8b40-2c15d8143c97","website_id":"3fb8982d-b3c5-48b2-b7a0-21073be3d08e","advertiser_id":"ca2b7538-91ec-42f4-8ed5-d5a3296b4480","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=41900&awinaffid=1263017&campaign=DALFILO+DE%2FAT&clickref=ebbf62c5-ae46-4b24-8b40-2c15d8143c97&clickref2=3fb8982d-b3c5-48b2-b7a0-21073be3d08e&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.dalfilo.de%2Fproducts%2Fperkal-set-bnc&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/VdNytYch","tracking_url_long":null,"sub_id":null,"hits":48,"unique_visitor":45,"advertiser":{"id":"ca2b7538-91ec-42f4-8ed5-d5a3296b4480","user_id":null,"network_source_id":null,"advertiser_id":41900,"api_advertiser_id":"ca2b7538-91ec-42f4-8ed5-d5a3296b4480","sid":89574665,"name":"DALFILO DE\/AT","currency_code":"EUR","average_payment_time":"30","validation_days":"1","epc":"1.51","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/dalfilodeat.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/41900.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"8","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["Germany"],"categories":["d60fc07d-ce1c-408c-888b-59114d593ba0"],"primary_regions":["DE"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["dalfilo.de","*.dalfilo.de"],"short_description":"Dalfilo ist ein  Startup, das handgefertigte italienische Heimtextilien herstellt.Unsere Vision ist es, das italienischen Kunsthandwerk wieder aufleben zu lassen und Kunden weltweit Zugang zur traditionellen italienischen Botteghe zu verschaffen.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">DALFILO DE\/AT Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Dalfilo ist eine digitale Marke, die handgefertigte italienische Heimtextilien direkt an den Kunden vertreibt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Unsere Vision ist es, den besten italienischen Kunsthandwerkern die M\u00f6glichkeit zu geben, direkt mit den globalen Verbrauchern in Kontakt zu treten und ihnen die M\u00f6glichkeit zu geben, die traditionellen italienischen Botteghe von \u00fcberall auf der Welt zu erwerben.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Wir investieren viel in unser Team, das sich aus jungen, talentierten, internationalen und ehrgeizigen Unternehmern, Software-Ingenieuren, Datenwissenschaftlern, Gesch\u00e4ftsentwicklern und Grafikdesignern zusammensetzt.<\/p><\/div>","program_policies":"<div id=\"container\" class=\"container-fluid\" bis_skin_checked=\"1\" style=\"margin-top: 0px; margin-bottom: -40px; padding: 0px; min-height: 100%; height: auto !important;\"><section id=\"content\" style=\"margin: 20px; padding: 0px; clear: both;\"><div class=\"row row-widget\" bis_skin_checked=\"1\" style=\"margin: 0px -10px; padding: 0px;\"><div class=\"col-md-9 col-lg-9 wrapper-widget\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px 10px; min-height: 1px; float: left; width: 836.25px;\"><div class=\"profileTabContent widget padding-LR-null\" id=\"profileTabContent\" bis_skin_checked=\"1\" style=\"margin: 0px 0px 20px; padding: 0px 0px 25px; border: 1px solid rgb(222, 222, 222); display: inline-block; border-radius: 2px; width: 816.25px; position: relative;\"><div class=\"col-lg-12\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px 20px; min-height: 1px;\"><div id=\"termsTabContent\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px;\"><div class=\"col-lg-12\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px 20px; min-height: 1px;\"><div id=\"termsFreeTextContentView\" class=\"inlineTextArea \" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Bedingungen und Konditionen<\/b><\/p><ol style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\"><b>ALLGEMEINE INFORMATIONEN<\/b><\/li><\/ol><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.1 Gegenstand dieser Allgemeinen Gesch\u00e4ftsbedingungen ist der Online-Verkauf von Produkten der Marke DALFILO, die Eigentum der DALFILO Srl sind, an Kunden \u00fcber die Website www.dalfilo.com.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.2 DALFILO Srl beh\u00e4lt sich das Recht vor, die Anzahl oder den maximalen Wert der Produkte, die gekauft werden k\u00f6nnen, zu begrenzen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.3 Dar\u00fcber hinaus beh\u00e4lt sich die Firma DALFILO Srl das Recht vor, auf einzelne Bestellungen zus\u00e4tzlich zu den vorliegenden Allgemeinen Gesch\u00e4ftsbedingungen besondere Vertragsbestimmungen und Verkaufsbedingungen (auch \"Besondere Bedingungen\") anzuwenden, die ausdr\u00fccklich in der Zusammenfassung der Bestellung angegeben werden und mit der Best\u00e4tigung der Bestellung als vom Kunden genehmigt gelten. Im Falle von Konflikten haben die Bestimmungen der Besonderen Bedingungen Vorrang vor den Allgemeinen Bedingungen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">&nbsp;<\/p><ol style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\"><b>VERTRAGSABSCHLUSS UND ANWENDUNG DER ALLGEMEINEN BEDINGUNGEN<\/b><\/li><\/ol><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.1 Die Vertr\u00e4ge \u00fcber den Verkauf von Produkten auf der Website www.dalfilo.com gelten als abgeschlossen, wenn die Bestellung des Kunden bei der Firma DALFILO Srl gem\u00e4\u00df dem unten angegebenen Verfahren eingeht und diese sie annimmt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.2 Dar\u00fcber hinaus muss der Kunde die vorliegenden Allgemeinen Gesch\u00e4ftsbedingungen w\u00e4hrend des Kaufvorgangs genehmigen, damit dieser erfolgreich abgeschlossen werden kann, und er ist verpflichtet, sie bei seinen Gesch\u00e4ften mit DALFILO Srl zu beachten und einzuhalten.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.3 DALFILO Srl fordert den Kunden auf, die vorliegenden Allgemeinen Gesch\u00e4ftsbedingungen nach Abschluss des Online-Kaufvorgangs aufzubewahren, da diese bereits w\u00e4hrend der Phase des Vertragsabschlusses eingesehen und akzeptiert wurden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">&nbsp;<\/p><ol style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\"><b>KAUFVORGANG<\/b><\/li><\/ol><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.1 Der Kunde erwirbt das von der Firma DALFILO Srl zum Verkauf angebotene Produkt, dessen Eigenschaften in den entsprechenden Beschreibungen und technischen Datenbl\u00e4ttern angegeben und abgebildet sind, zu dem dort angegebenen Preis zuz\u00fcglich der auf der Website angegebenen Lieferkosten.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.2 Der Kauf muss gem\u00e4\u00df den von DALFILO Srl auf ihrer Website zur Verf\u00fcgung gestellten Anweisungen und Verfahren erfolgen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.3 Vor dem Absenden der Bestellung werden die Einzelkosten f\u00fcr jedes ausgew\u00e4hlte Produkt, die Gesamtkosten beim Kauf mehrerer Produkte und die damit verbundenen Lieferkosten zusammengefasst.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.4 Nach dem Absenden der Bestellung erh\u00e4lt der Kunde von DALFILO Srl eine E-Mail, in der der Eingang der Bestellung best\u00e4tigt wird und die Informationen \u00fcber die wichtigsten Merkmale der gekauften Ware, eine detaillierte Angabe des Preises, die eventuellen Lieferkosten, einen Verweis auf die vorliegenden allgemeinen Bedingungen sowie die eventuellen besonderen Einkaufsbedingungen enth\u00e4lt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">&nbsp;<\/p><ol style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\"><b>ZAHLUNGSMODALIT\u00c4TEN UND LIEFERUNG DES PRODUKTS<\/b><\/li><\/ol><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4.1 Die Zahlungsmodalit\u00e4ten f\u00fcr die \u00fcber die Website erworbenen Produkte sind wie folgt:<\/p><ol style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">a) Paypal, unter Verwendung der auf der Website vorgeschlagenen Tools;<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">b) Kreditkarten und Prepaid-Karten, die mit den Angaben auf der Website und den akzeptierten Zahlungssystemen kompatibel sind.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">c) Nachnahme, die per Nachnahme an den Kurierdienst GLS zu leisten ist;<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">d) \u00dcberweisung, die zugunsten von:<\/li><\/ol><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>DALFILO SRL<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>BANK: INTESA SAN PAOLO<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>IBAN: IT07F0306953320100000004262<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">zum Zeitpunkt der Auftragsbest\u00e4tigung zu t\u00e4tigen ist. Der Versand wird zum Zeitpunkt des Eingangs der \u00dcberweisung durchgef\u00fchrt;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">11. e) Scalapay, ausf\u00fchrlich unter Punkt 11.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4.2 In keinem Fall wird eine Lieferung der Produkte vorweggenommen, wenn diese nicht bezahlt wurden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4.3 Die gekauften Waren werden per Kurier an die vom Kunden bei der Bestellung angegebene Adresse geliefert. Die entsprechende Rechnung wird dem Kunden zur Verf\u00fcgung gestellt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4.4 Es obliegt dem Kunden, sich bei der Lieferung zu vergewissern, dass die gelieferten Produkte der Bestellung entsprechen, frei von M\u00e4ngeln sind, die Verpackung versiegelt und nicht besch\u00e4digt ist. Sollte dies nicht der Fall sein, muss der Kunde dies unter supporto@dalfilo.com melden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>5. WIDERRUFSRECHT UND R\u00dcCKGABE DES PRODUKTS<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.1 Gem\u00e4\u00df Artikel 52 ff. des Verbraucherschutzgesetzes hat der Kunde das Recht, innerhalb von 60 Tagen nach Erhalt des Produkts ohne Angabe von Gr\u00fcnden und ohne Vertragsstrafe von jeder Bestellung zur\u00fcckzutreten.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.2 Im Falle der Aus\u00fcbung des R\u00fccktrittsrechts muss der Kunde DALFILO Srl durch eine ausdr\u00fcckliche Erkl\u00e4rung, die innerhalb der oben genannten 60 Tage an die E-Mail-Adresse supporto@dalfilo.com zu senden ist, \u00fcber seine Entscheidung, vom Vertrag zur\u00fcckzutreten, informieren. Sobald der Kunde von seinem R\u00fccktrittsrecht Gebrauch gemacht hat, schickt DALFILO Srl dem Kunden eine Best\u00e4tigungs-E-Mail, die Anweisungen f\u00fcr die R\u00fccksendung des Produkts und die Buchung der Abholung durch einen Kurierdienst enth\u00e4lt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.3 Das Produkt muss im Originalzustand und in der Originalverpackung, in einwandfreiem, sauberem Zustand sowie mit der Dokumentation und dem Zubeh\u00f6r zur\u00fcckgegeben werden. Besch\u00e4digte oder abgenutzte Produkte werden nicht angenommen, sondern nur solche, die sich in einem normalen Erhaltungszustand befinden und\/oder mit der \u00fcblichen Sorgfalt aufbewahrt werden. Sollte dies der Fall sein, beh\u00e4lt sich DALFILO Srl das Recht vor, dem Kunden keine R\u00fcckerstattung zu gew\u00e4hren.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.3.1 Im Falle einer mangelhaften Ware muss der Kunde den Mangel innerhalb von 14 Tagen nach Erhalt der Ware per E-Mail an supporto@dalfilo.com melden und die Zusendung eines Ersatzprodukts oder die R\u00fcckerstattung des gezahlten Preises verlangen. Um ein defektes Produkt zur\u00fcckzusenden, darf es vom Kunden nicht gewaschen oder benutzt worden sein. Sollte dies der Fall sein, beh\u00e4lt sich DALFILO Slr das Recht vor, den Ersatz oder die R\u00fcckerstattung des gezahlten Preises zu verweigern.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.4 DALFILO Slr muss auf eigene Kosten den Kurier je nach der vom Kunden angegebenen Verf\u00fcgbarkeit kontaktieren.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.5 Im Falle eines rechtsg\u00fcltig ausge\u00fcbten R\u00fccktritts und der R\u00fcckgabe des Produkts, wie oben beschrieben, wird DALFILO Srl den vom Kunden gezahlten Preis innerhalb von 14 Tagen nach Erhalt der Produkte zur\u00fcckerstatten und\/oder das vereinbarte Ersatzprodukt innerhalb von 14 Tagen nach Anfrage des Kunden zusenden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.6 Im Falle eines R\u00fcckgabeantrags f\u00fcr ein Produkt, das einen h\u00f6heren Wert hat als das zuvor gekaufte, beh\u00e4lt sich DALFILO Srl das Recht vor, die Zahlung des Differenzbetrags vor der Zusendung des Ersatzprodukts zu verlangen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.7 Falls der Kunde sein R\u00fccktrittsrecht unter Verletzung der in diesem Artikel 5 angegebenen Fristen und Modalit\u00e4ten aus\u00fcbt, steht es der Firma DALFILO Srl frei, die R\u00fcckgabe des Produkts nicht zu akzeptieren und die Betr\u00e4ge nicht wieder gutzuschreiben.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.8 Das R\u00fccktrittsrecht ist in jedem Fall in den folgenden F\u00e4llen ausgeschlossen:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">- Verkauf von Sonderanfertigungen oder personalisierten Waren (Art. 59, Buchstabe c des Verbraucherschutzgesetzes)<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>6. PRODUKTGARANTIE<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">6.1 Die dem Kunden vorbehaltenen Garantien auf das Produkt sind die im Verbrauchergesetzbuch und in jedem Fall gesetzlich vorgesehenen Garantien.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>7. RECHTE AN GEWERBLICHEM UND GEISTIGEM EIGENTUM<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">7.1 Die Website www.dalfilo.com, die Marke und jegliches gewerbliche und geistige Eigentum sind ausschlie\u00dfliches Eigentum der DALFILO Srl. Dazu geh\u00f6ren - ohne darauf beschr\u00e4nkt zu sein - alle Marken, Handelsnamen, Illustrationen, Bilder, Dokumentationen, Schriftzeichen, Design, Musik, Software, Codes und Formatskripte, die durch die geltenden Markengesetze und die einschl\u00e4gigen internationalen Vertr\u00e4ge gesch\u00fctzt sind.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">7.2 Die teilweise oder vollst\u00e4ndige Vervielf\u00e4ltigung auf jeglichem Datentr\u00e4ger, die Verwendung der Elemente, aus denen sich die Website www.dalfilo.com und der Katalog zusammensetzen, ihre Nutzung und ihre Weitergabe an Dritte sind verboten. Es ist daher verboten, die durch Urheberrechte, eingetragene Marken oder andere geistige und gewerbliche Eigentumsrechte gesch\u00fctzten Inhalte zu kopieren, zu verbreiten und zu ver\u00e4ndern.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>8. DATENSCHUTZ<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">8.1 F\u00fcr alle Informationen \u00fcber die Verwendung personenbezogener Daten verweisen wir auf die Datenschutzpolitik der DALFILO Srl.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>9. \u00c4NDERUNGEN UND HINWEISE<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">9.1 DALFILO Srl beh\u00e4lt sich das Recht vor, die vorliegenden Allgemeinen Gesch\u00e4ftsbedingungen jederzeit zu \u00e4ndern und den Kunden durch Ver\u00f6ffentlichung auf der Website www.dalfilo.com davon in Kenntnis zu setzen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">9.2 F\u00fcr alle Angelegenheiten, die nicht ausdr\u00fccklich von diesen Allgemeinen Bedingungen sowie von den Besonderen Bedingungen abgedeckt sind, wird ausdr\u00fccklich auf die Gesetzesverordnung Nr. 206 vom 6. September 2005 (Verbraucherschutzgesetz) und nachfolgende \u00c4nderungen sowie auf die geltenden Gesetze verwiesen, einschlie\u00dflich der Gesetzesverordnung Nr. 70 vom 9. April 2003 (Umsetzung der Richtlinie 2000\/60\/EG). 70 (Umsetzung der Richtlinie 2000\/31\/EG \u00fcber bestimmte rechtliche Aspekte der Dienste der Informationsgesellschaft, insbesondere des elektronischen Gesch\u00e4ftsverkehrs, im Binnenmarkt) und nachfolgende \u00c4nderungen sowie das Gesetzesdekret Nr. 196 vom 30. Juni 2003 (Datenschutzgesetz), das Zivilgesetzbuch usw.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>10. ANWENDBARES RECHT UND ZUST\u00c4NDIGES GERICHT<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">10.1 Das Vertragsverh\u00e4ltnis mit den Kunden, die vorliegenden Allgemeinen Bedingungen und die eventuellen Besonderen Bedingungen unterliegen ausschlie\u00dflich dem italienischen Recht und sind entsprechend auszulegen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">10.2 F\u00fcr alle Streitigkeiten im Zusammenhang mit dem Vertragsverh\u00e4ltnis mit den Kunden, den Allgemeinen Bedingungen und den Besonderen Bedingungen ist das Gericht in Mailand zust\u00e4ndig, unbeschadet des Gerichts am Wohnsitz oder Sitz des Kunden, wenn das Gesetz dies vorsieht.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>11. SCALAPAY<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">11.1 Wenn Sie \u00fcber Scalapay kaufen, erhalten Sie Ihre Bestellung sofort und zahlen in 3 Raten. Sie erkennen an, dass die Raten an Incremento SPV S.r.l., an verbundene Parteien und deren Bevollm\u00e4chtigte \u00fcbertragen werden und dass Sie diese \u00dcbertragung genehmigen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>12. RABATTCODES<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">12.1 Die DALFILO-Rabattcodes k\u00f6nnen nicht mit anderen Angeboten kombiniert werden, die derzeit auf der Website aktiv sind. Es ist daher nicht m\u00f6glich, die Rabattcodes auf bereits rabattierte Artikel anzuwenden.<\/p><\/div><\/div><\/div><\/div><\/div><\/div><\/div><div class=\"clear\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px; clear: both;\"><\/div><\/section><\/div>","url":"https:\/\/www.dalfilo.de\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=41900&id=1263017","type":"api","created_at":"2023-05-12T19:01:52.000000Z","updated_at":"2025-04-18T10:58:09.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":1,"custom_domain":"dalfilo.de"}}  
