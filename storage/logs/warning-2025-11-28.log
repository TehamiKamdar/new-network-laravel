[2025-11-28 21:19:57] production.INFO: {"id":"68f2c257-fc61-4163-8a3b-612a8d85cbac","publisher_id":"90cbb48a-9652-48f5-b3a4-c2402540f6b2","website_id":"8056da06-5e49-4b4b-b565-e6743ab17e69","advertiser_id":"838fa63e-fed9-44f9-b109-b2a0d6e1a912","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=6756&id=1263017&campaign=Bluebella&clickref=90cbb48a-9652-48f5-b3a4-c2402540f6b2&clickref2=8056da06-5e49-4b4b-b565-e6743ab17e69&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.bluebella.com%2Fcollections%2Fsale%3Fsort%3Dprice-low&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/1Jm50Sgf","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=68868224&linkaffid=90840260&ued=https%3A%2F%2Fwww.bluebella.com%2Fcollections%2Fsale%3Fsort%3Dprice-low","sub_id":null,"hits":1,"unique_visitor":1,"advertiser":{"id":"838fa63e-fed9-44f9-b109-b2a0d6e1a912","user_id":null,"network_source_id":null,"advertiser_id":6756,"api_advertiser_id":"838fa63e-fed9-44f9-b109-b2a0d6e1a912","sid":68868224,"name":"Bluebella","currency_code":"GBP","average_payment_time":"74","validation_days":"37","epc":"0.24","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/bluebella.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/6756.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"10","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["United Kingdom"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["*.bluebella.com","www.bluebella.com","bluebella.com"],"short_description":"Bluebella is a modern, directional lingerie and nightwear brand, with a design aesthetic that is redefining sensuality. The fashion led collections, which challenge traditional lingerie shapes, are designed primarily for women.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Bluebella Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Bluebella is a modern, directional, lingerie and nightwear brand, designed in-house at our London office. From the initial concept to the final product, the designs have a unique and exciting signature look, that reflects the strength and femininity of the Bluebella woman, and have an aesthetic that is redefining sensuality. Taking inspiration from the catwalk, and created at a price point that makes it highly accessible within the marketplace, our aim is to create lingerie and nightwear that makes every woman feel and look amazing. The collections embody the spirit and vitality of the Bluebella woman.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">The directional designs aim to challenge the classic lingerie shapes, to create lingerie that is wearable but fashion led. This is a fashion lingerie brand designed for every woman who believes that age is most definitely just a number.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>F<span style=\"margin: 0px; padding: 0px;\">ounder&nbsp;<\/span><\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Emily Bendell the brand founder is regularly featured in the press, as a fabulous example of an entrepreneur who literally started her business as a \u2018one woman brand\u2019&nbsp; and has worked from the ground up to create a multi-million pound business.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">The love and passion for the brand is stitched into every item produced. Proud of how far the brand has come, the team never look backwards, striving every day to build the brand profile and success by producing beautiful innovative lingerie and nightwear that is affordable and quite simply fabulous to look at and to wear.<\/p><\/div>","program_policies":"<p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Bluebella Specific Terms &amp; Conditions<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Commission will be paid to new and existing customers.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">The commission is paid on all the products available on Bluebella website.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">The transaction value that commissions are paid on include VAT however all other taxes, surcharges and any additional costs such as delivery are not included.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>What the merchant should pay for:<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Does the transaction value that commissions are paid on include VAT? No<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Does the transaction value that commissions are paid on include delivery charges? No<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Does the transaction value that commissions are paid on include credit card fees? No<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Does the transaction value that commissions are paid on include gift wrapping or other service charges? No<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Are commissions not paid out on some products or product categories? Not paid on gift vouchers.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Why are commissions declined?<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Order cancelled (Yes)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Item was returned (Yes)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Customer failed credit check (Yes)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Breach of programme terms and conditions (Yes)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Duplicate order (Yes)<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>What promotional types of affiliate are allowed to work on the programme?<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">CashBack (yes)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Community (yes)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Content (yes)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Discount Code (yes, but limited)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Email (yes)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Loyalty (yes)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">PPC (No)<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">PPC terms:<\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\"><b><span style=\"margin: 0px; padding: 0px;\">Do you allow affiliates to promote you via PPC?<\/span>No<\/b><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Do you have a restricted group of affiliates who are permitted to bid on brand and\/or brand related terms?<\/span>No<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">For any agreed affiliate PPC activity, are affiliates allowed to promote you on all search engines listed below?<\/span><ul><li style=\"margin: 0px; padding: 0px; list-style: none;\">Google (No)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Yahoo (No)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Bing (No)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Other (No)<\/li><\/ul><\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Brand guidelines:<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Before joining the Bluebella Affiliate Program, please ensure your website does not display or sell advertising on any website that contravenes any law or regulation governing false or deceptive advertising<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">The contents of marketing material and all websites owned by Bluebella&nbsp;Ltd, are protected by the law relating to trademark and copyright. Affiliates must not directly or indirectly bid on the Word Mark ' Bluebella&nbsp;' or derivatives or confusingly similar words<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">No Doorway pages to be built around searches for Bluebella<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">No Masked URL's (inc add to favourites buttons)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Must be able to navigate using the browsers back button<\/li><\/ul>","url":"https:\/\/www.bluebella.com\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=6756&id=1263017","type":"api","created_at":"2023-03-21T07:05:14.000000Z","updated_at":"2025-04-18T10:56:38.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":1,"custom_domain":"bluebella.com"}}  
