[2025-11-28 21:53:57] production.INFO: {"id":"85c3151d-b7ad-4d41-9ea0-c7d95903837a","publisher_id":"05a9a700-26b4-40cf-b660-a250e7220b38","website_id":"647d4915-9833-4ae2-94ff-3deb58bda2c6","advertiser_id":"2cb4ecf1-7311-4896-8d89-5094dcb3a4c1","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=31301&id=1263017&campaign=WAWWA&clickref=05a9a700-26b4-40cf-b660-a250e7220b38&clickref2=647d4915-9833-4ae2-94ff-3deb58bda2c6&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwawwaclothing.com%2Fcollections%2Fshirts&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/t1jA1XNGT1","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=69253598&linkaffid=23258573&ued=https%3A%2F%2Fwawwaclothing.com%2Fcollections%2Fshirts","sub_id":null,"hits":7,"unique_visitor":7,"advertiser":{"id":"2cb4ecf1-7311-4896-8d89-5094dcb3a4c1","user_id":null,"network_source_id":null,"advertiser_id":31301,"api_advertiser_id":"2cb4ecf1-7311-4896-8d89-5094dcb3a4c1","sid":69253598,"name":"WAWWA","currency_code":"GBP","average_payment_time":"64","validation_days":"37","epc":"0.36","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/wawwa.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/31301.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":0,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"10","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":0,"country_full_name":["United Kingdom"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["wawwaclothing.com","*.wawwaclothing.com"],"short_description":"If you\u2019re looking for fashion partners, apply to join our program today. We're a sustainable clothing brand especially looking for media, content creators, influencers, bloggers and vloggers that we can support with samples and generous commission.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">WAWWA Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">WAWWA is a UK based sustainable clothing brand using local production and durable design alongside organic + recycled materials. We create casual and wearable clothing designed for all genders and made to last.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Our partners are valued as part of our team and we always ensure that they're supported and rewarded for their work with generous, above average commission.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Our aim for our partners is for them to make excellent commissions working with us whilst creating brand awareness and sales\u2026win, win :)<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h3 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\"><span style=\"margin: 0px; padding: 0px; font-weight: normal;\">We offer:<\/span><\/h3><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We work with individuals and organisations who share in our mission of developing, buying and selling products that put people and the planet first.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Our affiliate programme pays you a commission for spreading our message, sharing our vision and promoting our products.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We have four different commission groups aimed at rewarding affiliates who want to share our products with a new audience:<\/p><ol style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Content Sites: (Sites with original written content): 15%<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Cashback Sites: 4%<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Coupon\/Discount Sites: 2%<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Standard Commission: (Sites which do not fit the above categories, such as charity incentive sites, CSS Shopping partners, shopping directories etc): 10%<\/li><\/ol><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">When joining the programme we will assign your site to the appropriate commission group. If you feel your site has been put into the incorrect commission group please get in contact and we will review it.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h3 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\"><span style=\"margin: 0px; padding: 0px; font-weight: normal;\">We\u2019re particularly interested in:<\/span><\/h3><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Fashion Editorial &amp; Press<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Creators<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Social Media Influencers<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Bloggers<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Vloggers<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">If this is you, please get in touch to discuss our program, so we can support you with access to further information, imagery, samples and commission.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h3 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\"><span style=\"margin: 0px; padding: 0px; font-weight: normal;\">Fast Facts<\/span><\/h3><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">30 Day Cookie \/ 60 Day for creators<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u00a368 AOV<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">30-day returns and 60-day validation window - FAST payment&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Excellent response rate and support<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Generous commission up to 15%&nbsp;<\/p><\/div>","program_policies":"<div class=\"col-lg-12\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px 20px; min-height: 1px; float: left; width: 870.25px;\"><div id=\"termsFreeTextContentView\" class=\"inlineTextArea \" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All partners are encouraged and expected to read and adhere to the terms and conditions below.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">For questions on these terms, please speak to - partnerships@wawwa.co<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Contact:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All partners must be contactable within a reasonable amount of time and provide an email address to contact them.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All partners agree to consult with the brand on at least a monthly basis to improve the relationship and their performance.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Promotions:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">It is agreed that before publishing, marketing activity will be sent to the relevant Partnerships Manager for approval.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Brand:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Partners agree to present the brand in the same manner the brand presents itself.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Partners will take reasonable care to use up-to-date images, ad-copy and offers (where relevant) in their marketing.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Paid Search Policy:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">No partner should run a paid search campaign using the brand terms without written consent.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Comparison Shopping Services:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">No partner should run a CSS campaign using the brand terms without written consent.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Display:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">No partner should run a display campaign using the brand terms without written consent.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Social Media:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">No partner should run a social media campaign using the brand terms without written consent.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Voucher Codes, Sales and Offers:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Partners should only promote voucher codes, sales and offers agreed by the Partnerships Manager.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Cashback:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Partners agree to a tiered approach where WAWWA may offer as little as 0.1% cashback to encourage consumers to spend more money to achieve higher rates.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Lead Generation:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Where Lead Generation is applicable, partners agree that leads will be qualified and declined a payment where they are: spam, not contactable after five tries, duplicates, tests and fraudulent.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Refusal:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Where WAWWA judge a breach of the terms is severe enough. And in consultation with an independent third party where available such as an Affiliate Network representative. Partner commissions can be refused (declined) for transactions relevant to the breach.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Validation and Payment of Commission:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Commissions are payable on genuine transactions and leads. WAWWA will validate transactions and leads to gauge if they are real.<\/p><\/div><\/div>","url":"https:\/\/wawwaclothing.com\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=31301&id=1263017","type":"api","created_at":"2023-03-21T07:06:05.000000Z","updated_at":"2025-11-07T07:52:36.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":0,"custom_domain":"wawwaclothing.com"}}  
