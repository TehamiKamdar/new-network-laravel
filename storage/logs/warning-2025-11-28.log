icy<\/div><div class=\"labelValue io_diff_line\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px 0px 0px 10px; line-height: 26px; font-size: 14px; word-break: break-word; display: table-cell;\">Reversal of performance advertising actions are decided by the Advertiser governed by a max reversal percentage of 100%<\/div><\/div><\/div><div class=\"labelLine\" bis_skin_checked=\"1\" style=\"margin: 20px 0px 0px; padding: 0px; display: table; width: 1071px;\"><div bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px; display: table-row;\"><div class=\"labelCell heading2text\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px; font-size: 14px; display: table-cell; width: 200px;\">Media Partner Tracking Pixel<\/div><div class=\"labelValue io_diff_line\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px 0px 0px 10px; line-height: 26px; font-size: 14px; word-break: break-word; display: table-cell;\">Advertiser does NOT allow media partner to fire their tracking pixel when the consumer action is completed.<\/div><\/div><\/div><\/div><\/div>","url":"https:\/\/nippon-sport.com","click_through_url":"https:\/\/nipponsport.sjv.io\/c\/4101692\/1647268\/19124","type":"api","created_at":"2023-04-27T06:49:14.000000Z","updated_at":"2025-04-30T09:44:06.000000Z","deleted_at":null,"is_show":0,"is_request__process":0,"is_active":0,"custom_domain":"nippon-sport.com"}}  
