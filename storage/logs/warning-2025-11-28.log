[2025-11-28 20:54:16] production.INFO: {"id":"eecdf0d6-c331-49d6-b639-2f1e63a7008b","publisher_id":"03bac09d-332c-40ee-b10a-4044bd23baad","website_id":"ea441a52-60d9-4350-878c-a23ab3a9b962","advertiser_id":"015a5b76-303c-4498-ac53-df82269f73bc","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=24319&id=1263017&campaign=Figopet+NL&clickref=03bac09d-332c-40ee-b10a-4044bd23baad&clickref2=ea441a52-60d9-4350-878c-a23ab3a9b962&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Ffigopet.nl%2F&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/t6tq3dM8T1cG","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=28652733&linkaffid=87186669&ued=https%3A%2F%2Ffigopet.nl%2F","sub_id":null,"hits":883,"unique_visitor":540,"advertiser":{"id":"015a5b76-303c-4498-ac53-df82269f73bc","user_id":null,"network_source_id":null,"advertiser_id":24319,"api_advertiser_id":"015a5b76-303c-4498-ac53-df82269f73bc","sid":28652733,"name":"Figopet NL","currency_code":"EUR","average_payment_time":"92","validation_days":"22","epc":"1.18","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/figopetnl.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/24319.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"25","commission_type":"EUR","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["Netherlands Antilles"],"categories":["4c1e7c4d-c90b-46b3-ab29-528a2c090a95"],"primary_regions":["NL"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["figopet.nl","*.figopet.nl"],"short_description":"Figopet is d\u00e9 ziekteverzekering voor je beste vriend.  Met onze huisdierenverzekering is je huisdier verzekerd zoals jij dat zelf ook bent. Zo krijgt je beste vriend de verzorging die hij nodig heeft en kom jij niet voor financi\u00eble verrassingen te staan.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Petplan NL Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Petplan is de nummer 1 dierenverzekeraar wereldwijd en daarom een logische keuze voor publishers. Petplan, opgericht door dierenartsen, is al ruim 45 jaar d\u00e9 huisdierenexpert en inmiddels hebben al 1,5 miljoen baasjes hun huisdier bij ons verzekerd. Bij ons heb je een verzekering voor elk budget, kun je zelf je dierenarts uitkiezen en is in 5 dagen je declaratie betaald.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Een nauwe samenwerking met Awin en publishers is voor ons erg belangrijk. Als publisher van Petplan kun je al onze pakketten promoten en gebruik maken van onze marketingacties. We hebben de voordelen van het promoten van Petplan voor je op een rij gezet.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Wat maakt Petplan aantrekkelijk voor promotie?<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Snelle keuring: geen ontdubbeling op paid advertising<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Verschillende en goed converterende landingspagina\u2019s beschikbaar per dier<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Aantrekkelijk bannermateriaal voor hond, kat, konijn en papegaai<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Regelmatig interessante marketingacties<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Klanten beoordelen ons met een 8,7!<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We staan open voor nauwe samenwerkingen<\/p><\/div>","program_policies":"<div class=\"col-lg-12\" style=\"margin: 0px; padding: 0px 20px; min-height: 1px; float: left; width: 868.611px;\"><div id=\"termsFreeTextContentView\" class=\"inlineTextArea \" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Keuringen<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">We keuren niet af als een een betaald kanaal als Google Paid als last click is geweest. Mocht er een sale door twee partners worden geclaimd&nbsp;dan geldt dat de sale wordt toegekend aan de partner die de laatste click heeft aangeleverd.&nbsp;<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Snelle keuring: geen ontdubbeling op paid advertising<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Commissie<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Verhoogde vergoeding mogelijk voor top publishers<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Per 1 september is het nieuw commissie model ge\u00efntroduceerd. De volgende commissies zullen gelden per goedgekeurde afgesloten verzekering bij Petplan.<\/p><table style=\"margin: 0px; padding: 0px; border-spacing: 0px; max-width: 100%;\"><tbody style=\"margin: 0px; padding: 0px;\"><tr style=\"margin: 0px; padding: 0px; border-top: 0px;\"><td style=\"margin: 0px; padding: 0px; border-top: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Petplan NL commissie structuur<\/b><\/span><\/td><td style=\"margin: 0px; padding: 0px; border-top: 0px;\"><b>Brons<\/b><\/td><td style=\"margin: 0px; padding: 0px; border-top: 0px;\">Zilver<\/td><td style=\"margin: 0px; padding: 0px; border-top: 0px;\">Goud<\/td><\/tr><tr style=\"margin: 0px; padding: 0px;\"><td style=\"margin: 0px; padding: 0px;\"><b>Transacties target p.m.<\/b><\/td><td style=\"margin: 0px; padding: 0px;\">0-50<\/td><td style=\"margin: 0px; padding: 0px;\">51-100<\/td><td style=\"margin: 0px; padding: 0px;\">101+<\/td><\/tr><tr style=\"margin: 0px; padding: 0px; border-bottom: 0px;\"><td style=\"margin: 0px; padding: 0px; border-bottom: 0px;\"><b>Commissie<\/b><\/td><td style=\"margin: 0px; padding: 0px; border-bottom: 0px;\">&nbsp;\u20ac 20,00&nbsp;<\/td><td style=\"margin: 0px; padding: 0px; border-bottom: 0px;\">&nbsp;\u20ac 37,50&nbsp;<\/td><td style=\"margin: 0px; padding: 0px; border-bottom: 0px;\">&nbsp;\u20ac 40,00&nbsp;<\/td><\/tr><\/tbody><\/table><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Zoals je hierboven ziet, hang de commissie af van het gemiddeld aantal transacties per maand. Ieder half jaar wordt er ge\u00ebvalueerd of de commissie nog klopt op basis van het resultaat, dat betekent dat 1 maart 2023 het eerstvolgende evaluatiemoment is. Echter kunnen we (tijdelijk) een partner in een hoger commissiemodel plaatsen bij extra promotiemogelijkheden.<\/p><div style=\"color: rgb(68, 68, 68); font-family: &quot;Whitney SSm A&quot;, &quot;Whitney SSm B&quot;, Tahoma, sans-serif; font-size: 12px;\"><br><\/div><\/div><\/div>","url":"https:\/\/figopet.nl\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=24319&id=1263017","type":"api","created_at":"2023-05-20T19:01:01.000000Z","updated_at":"2025-10-11T20:58:42.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":1,"custom_domain":"figopet.nl"}}  
