[2025-11-28 11:07:16] production.INFO: {"id":0,"publisher_id":"ebbf62c5-ae46-4b24-8b40-2c15d8143c97","website_id":"3fb8982d-b3c5-48b2-b7a0-21073be3d08e","advertiser_id":"3bb6b29e-ede6-493f-9b29-9f58ff19ec9b","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=16198&id=1263017&campaign=Biomenta+DE&clickref=ebbf62c5-ae46-4b24-8b40-2c15d8143c97&clickref2=3fb8982d-b3c5-48b2-b7a0-21073be3d08e&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.biomenta.de%2Fangebote-aktionen&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/TFMX0TY7","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=41820663&linkaffid=68006276&ued=https%3A%2F%2Fwww.biomenta.de%2Fangebote-aktionen","sub_id":null,"hits":17,"unique_visitor":15,"advertiser":{"id":"3bb6b29e-ede6-493f-9b29-9f58ff19ec9b","user_id":null,"network_source_id":null,"advertiser_id":16198,"api_advertiser_id":"3bb6b29e-ede6-493f-9b29-9f58ff19ec9b","sid":41820663,"name":"Biomenta DE","currency_code":"EUR","average_payment_time":"89","validation_days":"61","epc":"0.27","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/biomentade.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/16198.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"15","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["Germany"],"categories":["d605708e-6585-4b1a-8f7a-cbf3cc57b81e"],"primary_regions":["DE"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["*.biomenta.de","biomenta.de"],"short_description":"Die Firma Biomenta entwickelt und vertreibt seit \u00fcber 30 Jahren hochwertige Nahrungserg\u00e4nzungsmittel f\u00fcr Sport, Vitalit\u00e4t, Gesundheit und Beauty und hat sich als Anbieter echter Premiumware made in Germany erfolgreich am Markt etabliert.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Biomenta DE Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>\u00dcber die Firma Biomenta<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Biomenta entwickelt und vertreibt seit \u00fcber 30 Jahren hochwertige Nahrungserg\u00e4nzungsmittel f\u00fcr Gesundheit, Fitness, Sport, Vitalit\u00e4t und Beauty. Erstklassige Zutaten und zertifizierte Herstellungsprozesse nach IFS-Food und HACCP-Konzept sind f\u00fcr uns selbstverst\u00e4ndlich, sodass Kunden in unserem&nbsp;<a href=\"https:\/\/www.biomenta.de\/\" style=\"margin: 0px; padding: 0px; cursor: pointer; transition-property: color; transition-duration: 0.2s;\">Online-Shop<\/a>&nbsp;stets Premiumware direkt vom Hersteller erwerben k\u00f6nnen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">In den letzten Wochen und Monaten wurde das Sortiment kontinuierlich erweitert und wird es auch weiterhin, um dem wachsenden Bed\u00fcrfnis vieler Kunden nach Gesundheitsprodukten made in Germany gerecht zu werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Unser Sortiment reicht von Aminos\u00e4uren wie z. B. L-Arginin, \u00fcber verschiedene Vitamin-Produkte bis hin zu solchen aus sog. Superfoods f\u00fcr verschiedene Anwendungsbereiche wie z. B. Muskeln, Gelenke, Haut oder Haare.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Warum als Publisher f\u00fcr Biomenta aktiv werden?<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Attraktive, \u00fcberdurchschnittliche Publisher-Verg\u00fctung<\/span><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Steigender durchschnittlicher Warenkorb durch Sortimentserweiterung, darunter viele Komplement\u00e4rprodukte<\/span><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">\u00dcberdurchschnittliche Conversion-Rate<\/span>&nbsp;(Bezogen auf Angaben in Bericht v. 08.04.2016, mediaworx berlin AG \/ Chili Conversion)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Verkauf von<\/span>&nbsp;leicht verst\u00e4ndlichen, transparenten&nbsp;<span style=\"margin: 0px; padding: 0px;\">deutschen Markenprodukten<\/span>&nbsp;\u00fcber seri\u00f6sen, in Deutschland ans\u00e4ssigen H\u00e4ndler<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Sehr hohe Kundenzufriedenheit (4,91\/5 \u2013 ausgezeichnet.org)<\/span><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Wachsendes Marktumfeld<\/span>&nbsp;\/ zunehmender Trend zur zus\u00e4tzlichen, privat finanzierten Gesundheitsvorsorge, somit auch in Form von privat gekauften Nahrungserg\u00e4nzungsmitteln<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Attraktives Preis-Leistungsverh\u00e4ltnis f\u00fcr den Kunden<\/span>&nbsp;durch Wegfall von Zwischenh\u00e4ndlern, zus\u00e4tzliche regelm\u00e4\u00dfige verkaufsf\u00f6rdernde Ma\u00dfnahmen im Online-Shop<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Verkauf von Verbrauchsg\u00fctern - Retourenquote &lt; 0,5%<\/span><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Attraktives,&nbsp;vielf\u00e4ltiges, katalogisiertes und conversionstarkes Werbematerial zur Vermeidung von Streuverlusten auf Produkt- und Kategorieebene<\/span>: Anders als bei vielen anderen Advertisern erhalten Sie bei uns ma\u00dfgeschneidertes Werbematerial, egal ob Sie z. B. verschiedenste&nbsp;pot. Kunden ansprechen, sich mit Nahrungserg\u00e4nzungsmitteln im Allgemeinen besch\u00e4ftigen oder einen speziellen Themenblog betreiben&nbsp;<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Verg\u00fctung<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">15,00% ab dem ersten SALE, bis auf Weiteres (Stand Mai 2020)<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>\u200bFragen, Anregungen oder Kritik?<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Haben Sie Fragen zu unserem Werbematerial? Ben\u00f6tigen Sie eine von uns nicht standardm\u00e4\u00dfig angebotene Gr\u00f6\u00dfe? Oder w\u00fcnschen Sie ein bestimmtes Produkt auf dem Werbemittel?<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>-------------------------------------------------------------------------------------------------------------------------------------------------------<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Update Juni 2018: Unser Blog unter www.nahrungserg\u00e4nzungsmittel24.net kann fortan auch f\u00fcr Remarketing oder sonstige Kampagnen genutzt werden. Bei Interesse bitte Kontakt mit uns aufnehmen.&nbsp;<\/p><\/div>","program_policies":"<div class=\"col-lg-12\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px 20px; min-height: 1px;\"><div id=\"termsFreeTextContentView\" class=\"inlineTextArea \" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Liebe Publisher,<\/b><\/span><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">wir alle d\u00fcrfen uns gl\u00fccklich sch\u00e4tzen, einem der gr\u00f6\u00dften und renommiertesten Affili-Netzwerke anzugeh\u00f6ren. Genau wie AWIN Qualit\u00e4tsanforderungen an seine Publisher und Advertiser stellt, haben auch wir ein paar Bitten und W\u00fcnsche an Sie als Publisher:<\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Beachten Sie<\/span>&nbsp;bitte die&nbsp;<span style=\"margin: 0px; padding: 0px;\">Vorgaben und Anforderungen von AWIN<\/span>&nbsp;und ber\u00fccksichtigen Sie bitte \u00fcberdies&nbsp;<span style=\"margin: 0px; padding: 0px;\">etwaige einschl\u00e4gige gesetzliche Vorschriften<\/span>&nbsp;vor allem aus dem Bereich der Telemedien. Auch wenn wir hiervon ggf. nur indirekt betroffen sind, so m\u00f6chten wir \u00c4rger oder Unannehmlichkeiten in jeglicher Form vermeiden<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Wir erwarten, dass die zur Verf\u00fcgung gestellten&nbsp;<span style=\"margin: 0px; padding: 0px;\">Werbemittel in seri\u00f6ser und vern\u00fcnftiger Art und Weise und in einem angemessenen Rahmen pr\u00e4sentiert werden<\/span>, sodass die Marke Biomenta und die darunter vertriebenen Nahrungserg\u00e4nzungsmittel f\u00fcr den pot. K\u00e4ufer attraktiv und begehrenswert erscheinen<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Sollten&nbsp;<span style=\"margin: 0px; padding: 0px;\">Probleme mit Werbemitteln oder der Provisionsabrechnung<\/span>&nbsp;auftreten, bitten wir um&nbsp;<span style=\"margin: 0px; padding: 0px;\">Kontaktaufnahme<\/span>, sodass wir schnell und unb\u00fcrokratisch eine L\u00f6sung finden k\u00f6nnen<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Auch bei&nbsp;<span style=\"margin: 0px; padding: 0px;\">Verbesserungsvorschl\u00e4gen zu oder \u00c4nderungsw\u00fcnschen<\/span>&nbsp;von einzelnen Werbemitteln freuen wir uns \u00fcber Ihre&nbsp;<span style=\"margin: 0px; padding: 0px;\">Kontaktaufnahme<\/span><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Zu guter Letzt: Mit uns k\u00f6nnen Sie \u00fcber Vieles in h\u00f6flicher und vern\u00fcnftiger Art und Weise reden und einen gepflegten Umgangston setzen wir umgekehrt auch als selbstverst\u00e4ndlich voraus. Indem wir Hersteller und H\u00e4ndler zugleich sind, sind wir auch zu vielen \u201eSchandtaten\u201c bereit mit dem Ziel, dass beide Seiten und AWIN&nbsp;viel&nbsp;Freude und Erfolg an einer m\u00f6glichst nachhaltigen Zusammenarbeit haben<\/span><\/li><li style=\"color: rgb(68, 68, 68); font-family: &quot;Whitney SSm A&quot;, &quot;Whitney SSm B&quot;, Tahoma, sans-serif; font-size: 12px;\"><\/li><\/ul><\/div><\/div>","url":"http:\/\/www.biomenta.de","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=16198&id=1263017","type":"api","created_at":"2023-05-09T19:00:33.000000Z","updated_at":"2025-04-18T10:56:38.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":1,"custom_domain":"biomenta.de"}}  
