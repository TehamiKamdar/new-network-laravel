[2025-11-28 20:57:35] production.INFO: {"id":0,"publisher_id":"2cb22ca9-2da4-4e79-b499-e6f042a55fae","website_id":"78471f46-3aea-4178-98be-23952feb2804","advertiser_id":"cb1f445d-b681-4e41-bce5-71b45bcc2ef2","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=45489&awinaffid=1263017&campaign=Carfound&clickref=2cb22ca9-2da4-4e79-b499-e6f042a55fae&clickref2=78471f46-3aea-4178-98be-23952feb2804&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.carfound.co.uk%2Fproducts%2Fprestige-car-sourcing-service&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/xqPPS1ow","tracking_url_long":null,"sub_id":null,"hits":0,"unique_visitor":0,"advertiser":{"id":"cb1f445d-b681-4e41-bce5-71b45bcc2ef2","user_id":null,"network_source_id":null,"advertiser_id":45489,"api_advertiser_id":"cb1f445d-b681-4e41-bce5-71b45bcc2ef2","sid":99192546,"name":"Carfound","currency_code":"GBP","average_payment_time":null,"validation_days":null,"epc":null,"tags":null,"offer_type":null,"source":"Awin","logo":"storage\/carfound.png","fetch_logo_url":null,"is_fetchable_logo":0,"fetch_logo_error":null,"status":0,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"20","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":0,"country_full_name":["United Kingdom"],"categories":["4c1e7c4d-c90b-46b3-ab29-528a2c090a95","9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["carfound.co.uk","*.carfound.co.uk"],"short_description":"Carfound is a personal car finding service. We offer a highly personalised car buying experience to help you find, buy and drive away your dream car at a great price.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\">Carfound Affiliate Programme<\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Welcome to the Carfound affiliate programme! Right now, you\u2019re looking at our advertiser page, so if you\u2019re a publisher looking to promote our fantastic new brand - you\u2019re in the right place!<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Here\u2019s why you should work with us, what\u2019s in it for you and why we\u2019d love to work with you:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\">About Us<\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Carfound is a personal car finding service. We offer a highly personalised car buying experience to help you find, buy and drive away your dream car at a great price. There is a huge market for supporting consumers through their car buying journey as often, the journey is confusing, time consuming and difficult to navigate.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We were built on our pure passion and love for cars and all things automotive. We're proper petrolheads and wanted to translate our love of cars into a disruptive business model that takes all the pain out of buying a car as we do all the legwork for you.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Whilst we're relatively new in the market, our founder, Faisal Aiman has been sourcing cars for our clients for nearly 15 years. Our clients keep coming back due to the exceptional quality of cars, personalised service and significant savings we consistently deliver.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We offer the following core services:<\/p><ol style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">New Car Sourcing Service \u00a3199:<\/span>&nbsp;For clients who want to get a great deal on a brand new car that meets their needs<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Used Car Sourcing Service \u00a3199:<\/span>&nbsp;For clients who want to get a great deal on a used car that meets their needs<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Personal Car Shopper Service \u00a3249:&nbsp;<\/span>For clients that don't know where to start with their car buying journey and need guided support throughout the process<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Prestige Car Sourcing Service \u00a3399:<\/span>&nbsp;For clients who are after a high value vehicle i.e \u00a350,000+<\/li><\/ol><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\">Programme Details<\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We are looking for new publishers to join our programme to help us gain new clients to make great savings on their next car. By signing up to the Carfound Affiliate Programme, you\u2019ll be rewarded on a Commission Per Acquisition (CPA) basis for every new client that successfully makes a purchase with Carfound.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">The commission structure is simple and is on a Commision Per Acquisition (CPA) basis. Acquisition is defined as clients that have made a successful purchase on the Carfound website.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\">Transaction Percentage<\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">As we're a new startup, we're investing heavily in our Carfound Affiliate Programme. Our main goals are to raise brand awareness and attract new customers in rapid timeframe of 3 months.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">We are offering a significant 20% CPA<\/span>&nbsp;for a limited timeframe of 3 months only from 20\/02\/23. This will drop down to 10% from 20\/05\/23.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We do have a minimum level of performance that we expect our partners to meet in order to make the partnership viable and for it to continue. Should a publisher have a poor transaction rate, Carfound reserve the right to suspend further activity on the campaign.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">If for any reason we must terminate a partner from the programme, we shall give 7 days notice via email. All validated and applicable acquisitions generated during the notice period shall be paid per normal process.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Cookie Length: 30 days.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All links, banners and email creatives are available on request. We also send a weekly newsletter on a Monday (where possible) containing our latest offers all with links, terms &amp; conditions and creatives of all offers we have live at the time.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\">Affiliate Relationships<\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We would welcome the opportunity to work with our affiliates a little closer so that we can foster a productive partnership that is mutually beneficial to both parties. Working with you closely and collaborating on campaigns, enables the opportunity for bespoke promotions, competitions and features. We encourage regular touchpoints with our publishers so that we can share ideas, suggestions and thoughts to help drive optimal performance.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25;\">Additional Terms and Conditions<\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Carfound is a registered data controller with the ICO and takes GDPR very seriously. Any affiliates we work with must confirm that they will adhere to GDPR compliance.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">For all influencers on our programme, please ensure that you send us content to approve so we can finalise wording before posting. We do this for all recently onboarded affiliates to ensure quality of messaging. If we can ensure all ASA guidelines are being met and if you are using your affiliate links for us, this will need to be clearly displayed for your audience to see.<\/p>","program_policies":"<p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Whilst we encourage affiliates to promote our products via PPC, members of our affiliate programme are not permitted to bid on Carfound branded keywords (including misspellings) or use our display URL.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">This includes any phrase using the following keywords (upper or lower case):<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Carfound, Car Found, Carfound Limited<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">No commission in any given month will be paid to affiliates who breach our guidelines and affiliates may be removed from the program.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please note \u2013 this programme operates with a 7 day closure notice period.<\/p>","url":"https:\/\/www.carfound.co.uk","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=45489&id=1263017","type":"api","created_at":"2023-03-21T07:06:29.000000Z","updated_at":"2025-04-30T09:44:19.000000Z","deleted_at":null,"is_show":0,"is_request__process":0,"is_active":0,"custom_domain":"carfound.co.uk"}}  
