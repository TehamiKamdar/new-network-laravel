[2025-11-28 21:43:48] production.INFO: {"id":"7c844b2b-22e0-4e91-8013-6e6219e81d0b","publisher_id":"90cbb48a-9652-48f5-b3a4-c2402540f6b2","website_id":"8056da06-5e49-4b4b-b565-e6743ab17e69","advertiser_id":"b60d5737-b453-42cb-b14e-1e6198f47683","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=16071&id=1263017&campaign=Chisholm+Hunter&clickref=90cbb48a-9652-48f5-b3a4-c2402540f6b2&clickref2=8056da06-5e49-4b4b-b565-e6743ab17e69&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.chisholmhunter.co.uk%2Fsale.html&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/z8v1wMzjWA","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=17620494&linkaffid=90840260&ued=https%3A%2F%2Fwww.chisholmhunter.co.uk%2Fsale.html","sub_id":null,"hits":18,"unique_visitor":16,"advertiser":{"id":"b60d5737-b453-42cb-b14e-1e6198f47683","user_id":null,"network_source_id":null,"advertiser_id":16071,"api_advertiser_id":"b60d5737-b453-42cb-b14e-1e6198f47683","sid":17620494,"name":"Chisholm Hunter","currency_code":"GBP","average_payment_time":"122","validation_days":"76","epc":"0.12","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/chisholmhunter.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/16071.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"10","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["United Kingdom"],"categories":["d60fc07d-ce1c-408c-888b-59114d593ba0","9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["www.chisholmhunter.co.uk","*.chisholmhunter.co.uk","chisholmhunter.co.uk"],"short_description":"Established in 1857, Chisholm Hunter is one of the UK's leading specialists of beautiful diamonds, fine jewellery and luxury watches.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Chisholm Hunter Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Join our Affiliate Program and Start Earning Today!<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">A family-owned jewellers and diamond merchant since 1857, with 28 stores across Scotland and England. We hand pick the finest quality gemstones and diamonds from around the world.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We stock classic and contemporary diamond rings, jewellery designs and prestigious watch brands such as Vacheron Constantin, Longines, Tudor, IWC, Omega, TAG Heuer, Gucci and more. Through the programme you can promote all of Chisholm Hunter's products.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Why choose Chisholm Hunter?<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Established in 1857 and still family-owned today<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">A jewellery and luxury watch retailer loved by everyone<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Attractive deals on a wide range of diamonds, jewellery and watches<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>What we can offer:<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">30 day cookie period and fantastic opportunities to earn more through cross-selling<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">A variety of tools available<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">A simple deep linking process<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Full time account management and support<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Competitive commissions<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Average order value of: \u00a3400<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Site Visitors: Over 1 million\/year<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Exclusive imagery<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Terms &amp; Conditions for Affiliate Cashback<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Chisholm Hunter offers a 30-day return\/refund policy to all of our customers from the date of despatch, commission will not be paid on items that have been returned or refunded inside this period, for this reason, commissions will only be verified 30 days from the date of despatch. Purchases bought using interest free credit may cause your cashback to be declined or reduced. Purchases bought using additional discount that reduces your overall purchase price may cause your cashback to be declined or reduced. e.g Voucher codes, student discount, staff discount etc.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Cashback will not be paid if any of the following occurs;<\/b><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">On Purchases of selected brands \u2013 A.Lange Sohne, Blancpain, Breguet,&nbsp;FABERG\u00c9, Grand Seiko, IWC, Omega, TUDOR, Vacheron Constantin, Zenith and Pre-owned products.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">On purchases of Certified diamonds<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">On purchases of limited edition or exclusive pieces<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">On repairs or bespoke design If you pay for your purchase using a gift card If you pay for your purchase using Claims Service Cards\/ Insurance Cards<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">If you participate in any other offer\/ promotion that is not covered in the retailer cashback rates e.g free gift with purchase If you purchase a gift card<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">If your purchase is not fully completed online<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Ad Text for the Promotion of Chisholm Hunter<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Due to the exclusivity of the brands stocked, Chisholm Hunter does not operate in the cut price or discount marketplace. As such, any misleading adword text offering or promoting specific discount amounts i.e. 20%, 30%, 40% off etc is forbidden, Chisholm Hunter reserve the right to cancel any commission for that period and at our discretion also reserve the right to remove the affiliate from the programme.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Restrictions<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>The following sites will be rejected or immediately suspended for the following activity;<\/b><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Promoting adult\/explicit or offensive content<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Promoting gambling, bad debt, tobacco, illegal or misleading activity<\/li><\/ul><\/div>","program_policies":"<div class=\"col-lg-12\" bis_skin_checked=\"1\" style=\"margin: 0px; padding: 0px 20px; min-height: 1px;\"><div id=\"termsFreeTextContentView\" class=\"inlineTextArea \" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Commissions are most commonly declined due to a sale been&nbsp;allocated to&nbsp;a different marketing channel, use of unauthorised discount codes, accepting a free gift,&nbsp;the same order being recorded twice and due to the customer cancelling or returning their order. This will be flagged in the decline reason.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Chisholm Hunter allow the below promotional types of affiliates on the programme:<\/b><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">CashBack<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Community<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Content<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Email<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Loyalty<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Sites with the below content are not allowed:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Adult sites, gambling sites, sites which promote violence or unseemly behaviour.&nbsp; Any sites not appropriate to our brand.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Only Chisholm Hunter approved publishers may sell Chisholm Hunter products over the phone.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Without express permission to sell to customers over the phone, any publisher found engaging in this activity&nbsp;will be immediately removed from the programme and their commission's will be declined.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Subnetworks<\/b><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">If you operate a subnetwork through your publisher account you must inform the Chisholm Hunter affiliate team and a list of all URLs promoting Chisholm Hunter should be supplied. Chisholm Hunter reserve the right to decline individual URLs if not deemed editorially appropriate.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Any URL providing more than 5% of your sales volume should be tracked into a secondary PID for legal and audit purposes unless agreed otherwise in writing with Chisholm Hunter.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Any URL which joins a subnetwork will join on the Standard Awin Programme rates unless agreed otherwise in writing with Chisholm Hunter.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Failure to adhere to these conditions may result in immediate removal from the Chisholm Hunter programme of either the URL and \/ or where necessary, the subnetwork.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Disputed transactions<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">The merchant will investigate disputed transactions within 75 days from submission.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Affiliate Removals<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Awin will review all affiliates on a monthly basis who have been inactive for the past three months. Inactive is defined in this instance as any affiliate who has not driven a sale within that time period. This may result in removal from the programme. Those affiliates who have been removed through inactivity are welcome to re-apply to the programme, but must go through the approval process once again.&nbsp;<\/p><div bis_skin_checked=\"1\" style=\"color: rgb(68, 68, 68); font-family: &quot;Whitney SSm A&quot;, &quot;Whitney SSm B&quot;, Tahoma, sans-serif; font-size: 12px;\"><br><\/div><\/div><\/div>","url":"https:\/\/www.chisholmhunter.co.uk\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=16071&id=1263017","type":"api","created_at":"2023-05-10T19:00:30.000000Z","updated_at":"2025-04-18T10:56:45.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":1,"custom_domain":"chisholmhunter.co.uk"}}  
