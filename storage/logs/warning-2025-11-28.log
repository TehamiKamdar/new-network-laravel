[2025-11-28 21:27:56] production.INFO: {"id":809,"publisher_id":"ebbf62c5-ae46-4b24-8b40-2c15d8143c97","website_id":"3fb8982d-b3c5-48b2-b7a0-21073be3d08e","advertiser_id":"460c6ec9-ef54-4c15-9c0b-8be177f3885f","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=24827&awinaffid=1263017&campaign=DECORAMI+DE&clickref=ebbf62c5-ae46-4b24-8b40-2c15d8143c97&clickref2=3fb8982d-b3c5-48b2-b7a0-21073be3d08e&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fdecorami.de%2Fcollections%2Fhalloween&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/0h8hqN2a","tracking_url_long":null,"sub_id":null,"hits":26,"unique_visitor":25,"advertiser":{"id":"460c6ec9-ef54-4c15-9c0b-8be177f3885f","user_id":null,"network_source_id":null,"advertiser_id":24827,"api_advertiser_id":"460c6ec9-ef54-4c15-9c0b-8be177f3885f","sid":56300512,"name":"DECORAMI DE","currency_code":"EUR","average_payment_time":"70","validation_days":"49","epc":"0.08","tags":null,"offer_type":null,"source":"Awin","logo":null,"fetch_logo_url":null,"is_fetchable_logo":0,"fetch_logo_error":null,"status":0,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"10","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":0,"country_full_name":["Germany"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["DE"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["*.decorami.de"],"short_description":"DECORAMI ist der Online Shop f\u00fcr stylische Party- und Dekoartikel sowie Helium-gef\u00fcllte Ballon Sets mit starker Social Media Pr\u00e4senz.Mit unserer Eigenmarke DECORAMI verfolgen wir die Vision Partys nachhaltiger zu machen! #celebratehappytimes","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">DECORAMI DE Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">DECORAMI ist ein f\u00fchrender deutscher Online-Shop im Bereich Party- und Dekoartikel. Bei uns gibt es f\u00fcr jeden Anlass tolle Dekoprodukte, die Veranstaltungen zu etwas ganz Besonderem machen! Unser Produktportfolio umfasst \u00fcber 2.000 Produkte und Sets von Papierdekoration wie Pompoms oder Lampions \u00fcber Girlanden, Latexballons, Konfetti und Helium-gef\u00fcllten Ballons.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Bei unserer Eigenmarke DECORAMI dreht sich alles um Nachhaltigkeit - wiederverwendbar, recycelt, biologisch abbaubar und zunehmend&nbsp;in Packungen ohne Plastik. Das ist unserer Meinung nach ein Wandel, den die Branche dringend n\u00f6tig hat. Unsere Eigenmarken ist bereits in einigen Edeka M\u00e4rkten gelistet und das ist erst der Anfang ;)<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Als&nbsp;Teil von unserem Affiliate Programm, stellst du DECORAMI deiner Community vor. Wir suchen nach strategischen Partnern, die neue User auf unsere Website bringen und konvertieren. Wir m\u00f6chten unsere Marke, Mission und Produkte behannter machen und suchen daher haupts\u00e4chlcih nach Blogger:innen, Vlogger:innen und Social Media Influencer:innen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Deine&nbsp;Vorteile:<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">15% vom Netto Warenkorb<\/span><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Hohe Conversion Raten durch st\u00e4ndige Verbesserung unserer User Experience<\/span><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Schnelle Best\u00e4tigung von Provisionen (i.d.R. nach 15 Tagen, sp\u00e4testens jedoch nach 30 Tagen)<\/span><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Ausgew\u00e4hlte und bereits getestete erfolgreiche Werbemittel<\/span><\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\"><span style=\"margin: 0px; padding: 0px;\">Schnelle und pers\u00f6nliche Unterst\u00fctzung durch das DECORAMI Team<\/span><\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u200bDECORAMI liefert aktuell nach Deutschland und \u00d6sterreich mit Standard und Express Versand und zum Wunschdatum.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Bei Fragen oder Ideen, melde dich gerne bei lina@decorami.de.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Wir freuen uns auf deine Bewerbung und eine erfolgreiche Zusammenarbeit!<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Dein DECORAMI Team<\/p><\/div>","program_policies":"<p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Allgemeine Gesch\u00e4ftsbedingungen f\u00fcr das DECORAMI Affiliate Programm \u00fcber AWIN:<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Teilnahme erst nach Best\u00e4tigung von uns. Wir suchen passende&nbsp;Partner&nbsp;mit guten und aktuellen Websites.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Falls die Konditionen nicht befolgt werden, k\u00f6nnen wir die Kommision zur\u00fcckweisen.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">R\u00fccksendungen, Stornos und Ablehnungen aufgrund mangelnder Bonit\u00e4t werden nicht provisioniert<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">SEM - Suchmaschinenmarketing mit der Marke DECORAMI in der Display-URL, angezeigten Webseiten-Adressen, in der \u00dcberschrift von Anzeigen und in Suchmaschinen-Anzeigen ist nicht gestattet.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Brand Bidding ist nicht gestattet (dies gilt f\u00fcr die Marke DECORAMI, die URL und Vertipper)&nbsp;und f\u00fchrt zur Stornierung der Sales und Beendigung der Partnerschaft. Publisher d\u00fcrfen nur Keywords verwenden, die in keiner Verbindung zu DECORAMI stehen.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Folgende Umfelder sind f\u00fcr die Bewerbung unseres Programms nicht erw\u00fcnscht: rassistisch, extremistisch, volksverhetzend, gewaltverherrlichend oder dazu aufrufend, pornografisch\/erotisch, diffamierend gegen\u00fcber Menschen hinsichtlich deren Herkunft, Religion, sexueller Orientierung sowie Inhalte, die rechtswidrig sind.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Brand - Affiliates m\u00fcssen sich an unsere Markenidentit\u00e4t halten und d\u00fcrfen nur unser original Logo ohne Ver\u00e4nderungen nutzen.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Social Content - Content auf Social Media muss immer mit #Ad \/ #Werbung gekennzeichnet sein.klicken. Klicks d\u00fcrfen nicht direkt auf www.decorami.de landen, au\u00dfer sie kommen von Affiliate E-Mails.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Alle Klicks m\u00fcssen zuerst auf der Publisher Website landen und der Nutzer muss von der Seite des Publishers auf www.decorami.de<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Vor der Verwendung eines Gutschein- bzw. Promotioncodes muss Erlaubnis daf\u00fcr erteilt worden sein. Publisher d\u00fcrfen weder nicht autorisierte Gutschein-\/Promotioncodes verwenden, noch d\u00fcrfen sie auf Ihrer Website eine URL zu einem solchen Gutschein-\/Promotioncode nennen.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Es ist nicht gestattet, die DECORAMI-Website in einem iFrame in andere Websites einzubinden und hierbei einen Cookie zu setzen.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Sofern DECORAMI die Entfernung von Aktionen\/Werbemitteln verlangt, ist der Publisher dazu verpflichtet, diesem Verlangen unverz\u00fcglich nachzukommen.&nbsp;<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><a href=\"https:\/\/www.decorami.de\/agb\/\" style=\"margin: 0px; padding: 0px; cursor: pointer; transition-property: color; transition-duration: 0.2s;\">DECORAMI AGB<\/a><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Kontakt: info@decorami.de<\/p>","url":"https:\/\/www.decorami.de\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=24827&id=1263017","type":"api","created_at":"2023-03-21T07:05:40.000000Z","updated_at":"2025-04-30T09:46:33.000000Z","deleted_at":null,"is_show":0,"is_request__process":0,"is_active":0,"custom_domain":"decorami.de"}}  
