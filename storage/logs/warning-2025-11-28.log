[2025-11-28 21:42:17] production.INFO: {"id":"0afdbb65-a1ce-4fc4-a34a-536ca27377dd","publisher_id":"2cb22ca9-2da4-4e79-b499-e6f042a55fae","website_id":"78471f46-3aea-4178-98be-23952feb2804","advertiser_id":"b8e8c39f-2f57-4ca9-b8e8-a06c97c24447","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=18500&awinaffid=1263017&campaign=Club+L+London&clickref=2cb22ca9-2da4-4e79-b499-e6f042a55fae&clickref2=78471f46-3aea-4178-98be-23952feb2804&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fclubllondon.com%2Fcollections%2Fjumpsuits-playsuits%3Foffset%3D30&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/abW2mzxb","tracking_url_long":null,"sub_id":null,"hits":6,"unique_visitor":6,"advertiser":{"id":"b8e8c39f-2f57-4ca9-b8e8-a06c97c24447","user_id":null,"network_source_id":null,"advertiser_id":18500,"api_advertiser_id":"b8e8c39f-2f57-4ca9-b8e8-a06c97c24447","sid":30843164,"name":"Club L London","currency_code":"GBP","average_payment_time":"98","validation_days":"46","epc":"0.05","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/clubllondon.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/18500.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"5.12","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["United Kingdom"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["*.clubllondon.com","clubllondon.com"],"short_description":"Club L London is the next-generation online fashion retailer for the forward-thinking consumer. Expertly designed in-house, Club L specialises in accessible luxury, unique designs and unrivalled quality made to flatter every figure in sizes 4-24.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Club L London Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>About Clubllondon.com<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Club L London is the next-generation online fashion retailer for the forward-thinking consumer. Expertly designed and crafted in-house, Club L specialises in accessible luxury, unique designs and unrivalled quality made to flatter every figure in sizes 4-24. From prom to occasion, am-to-pm, maternity, bridal, limited edition and more, we deliver an engaging customer experience connecting our global community of diverse consumers, international fashion influencers and content creators with our new and exciting collections dropping weekly.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Founded in 2007, Club L was created with the vision of offering long lasting luxury styles, trend-oriented collections with a twist and unique, statement designs that offer both exceptional quality and fit in an otherwise saturated market of fast-fashion and throw away goods. We offer accessible luxury through considered purchasing, limited edition collections that leave no wastage and responsible manufacturing, as well as being world-renowned for premium fabrications, inclusive sizing, and affordable price points.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">With over a million visitors per month, shopping from over 150 global territories, Club L has experienced phenomenal, ongoing growth.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Join the Club and become one of our Affiliates and earn commission when you promote your favourite new pieces.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Club L London Offers:&nbsp;<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Up to 7% commission (excluding VAT and P&amp;P on the final transaction amount after all discounts have been applied).<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">30 Day cookie length.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Industry standard sized banners \u2013 updated regularly using the latest creative.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Regular updated feeds with a variety of new in products from all collections.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Affiliate newsletter updates with trends, news and the latest offers.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Opportunities to run exclusive partnerships with Club L London.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">An Excellent AOV and conversion rate<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Please note: VAT and Delivery charges do not qualify for commission.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>PPC<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please note Club L London will not pay commission to affiliates carrying out any unauthorised brand bidding and brand + product bidding for the duration the bidding takes place. Publishers are not permitted to bid on the brand or brand and product terms.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Validations<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All commissions will be validated on a 45&nbsp;day period and Club L London reserves the right to decline commission on all returned goods.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Branding<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please ensure you are&nbsp;use&nbsp;the most up to date logo and branding which is used on the network profile - if you need different sizes please get in touch.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Campaigns<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Club L London may share details of upcoming campaigns or promotions with its affiliates under embargo. Affiliates must not share this information publicly or with any other company ahead of any launch date when an embargo is in place. Doing so will result in loss of commissions and\/or termination from the programme.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Contact Us<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Got a question or need some more information? Feel free to get in touch with our Affiliate team at&nbsp;<a href=\"mailto:affilates@clubllondon.com\" style=\"margin: 0px; padding: 0px; cursor: pointer; transition-property: color; transition-duration: 0.2s;\">affilates@clubllondon.com<\/a><\/p><\/div>","program_policies":"<p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Terms and Conditions<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please note that failure to comply with these terms and conditions could result in your relationship being terminated and\/or any commissions earned being reversed.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Examples include, but are not limited to the following:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Voucher Code \/ Discount Code&nbsp;Affiliates<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All voucher code affiliates are expected to adhere to the below:<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Club L London asks that affiliates adhere to the new guidelines from the Internet Advertising Bureau Affiliate Marketing Council (IAB AMC). Therefore, the terms &amp; conditions of this affiliate programme have been set to reflect these guidelines:<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">1. Using \"Click to Reveal\" when there is no valid or current code present is not permitted for affiliate publishers using \"Click to Reveal\" to show any deals \/ offers \/ sales instead of vouchers.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2. Voucher code affiliate publishers must clearly detail the voucher offer that will be revealed by the click.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">3. A valid code or promotion is defined as a code that has been legitimately issued by Club L London for use by affiliates and not a code that has been issued to consumers direct. This code or promotion will have an activation date and where necessary a deactivation date.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">4. Voucher code directories must contain clear categorisation and separation between deals \/ offers \/ sales and discount codes.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5. Publishers are not allowed to promote\/display any student discount offer unless previously agreed with the Club L London team directly.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">6. Publishers are not permitted to promote\/display Club L London\u2019s Black Friday\/Cyber Monday\/ Cyber Week offers unless previously agreed with the Club L London team directly.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Furthermore, the following offers cannot be promoted\/displayed:<\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">App Only<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Email\/Social (those are exclusive to the specific channel)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Codes that belong to other publishers<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Student discounts (unless previously agreed with the Club L London team directly).<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Codes\/offers that haven\u2019t been specifically passed to you by Club L London\/Awin directly.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Creative \/ Branding<\/span><br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Affiliates may not alter any of the creative or text links available through the Awin&nbsp;interface. Affiliates are also requested not to hardcode banners into their sites, so updates made to those through Awin&nbsp;may take immediate effect.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Anyone found infringing on these terms will receive a warning and may have commissions reversed. We reserve the right to withhold commission during this time. Continuous infringement of these terms will result in suspension.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please refer to brand guidelines to ensure you are representing the brand in the correct way<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">I-frames<\/span><br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Affiliates may not put the Club L London website into frames or use masked URLs.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Product Feed&nbsp;<\/span><br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">The Club L London data feed with up-to-the-minute pricing information will be refreshed each day.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 