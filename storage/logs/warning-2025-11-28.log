[2025-11-28 21:21:50] production.INFO: {"id":0,"publisher_id":"a4b978f6-8090-4505-806e-66f8af4eabc5","website_id":"66e9e462-97d0-49e4-ba91-159f4c4edefc","advertiser_id":"038dcbf6-7c04-4c8e-9021-b1b69232126f","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=31521&awinaffid=1263017&campaign=Club+L+London+AU&clickref=a4b978f6-8090-4505-806e-66f8af4eabc5&clickref2=66e9e462-97d0-49e4-ba91-159f4c4edefc&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fclubllondon.com.au%2Fcollections%2Fnew-in%3Foffset%3D15%26utm_source%3DAWIN%26utm_medium%3DAffiliates%26utm_campaign%3D%21%21%21sitename%21%21%21%26utm_term%3D%21%21%21promotype%21%21%21&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/EFy0Yq8t","tracking_url_long":null,"sub_id":null,"hits":75,"unique_visitor":68,"advertiser":{"id":"038dcbf6-7c04-4c8e-9021-b1b69232126f","user_id":null,"network_source_id":null,"advertiser_id":31521,"api_advertiser_id":"038dcbf6-7c04-4c8e-9021-b1b69232126f","sid":27344166,"name":"Club L London AU","currency_code":"AUD","average_payment_time":"185","validation_days":"46","epc":"0.26","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/clubllondonau.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/31521.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"7","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["Australia"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["AU"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["clubllondon.com.au","*.clubllondon.com.au"],"short_description":"Club L London is the next-generation online fashion retailer for the forward-thinking consumer. Expertly designed in-house, Club L specialises in accessible luxury, unique designs and unrivalled quality made to flatter every figure in sizes 4-24.","description":"<h2 class=\"margin-top-sm\" style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Club L London AU Affiliate Program<\/h2><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">About ClubLLondon.com<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Club L London is the next-generation online fashion retailer for the forward-thinking consumer. Expertly designed and crafted in-house, Club L specialises in accessible luxury, unique designs and unrivalled quality made to flatter every figure in sizes 4-24. From prom to occasion, am-to-pm, maternity, bridal, limited edition and more, we deliver an engaging customer experience connecting our global community of diverse consumers, international fashion influencers and content creators with our new and exciting collections dropping weekly.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Founded in 2007, Club L was created with the vision of offering long lasting luxury styles, trend-oriented collections with a twist and unique, statement designs that offer both exceptional quality and fit in an otherwise saturated market of fast-fashion and throw away goods. We offer accessible luxury through considered purchasing, limited edition collections that leave no wastage and responsible manufacturing, as well as being world-renowned for premium fabrications, inclusive sizing, and affordable price points.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">With over a million visitors per month, shopping from over 150 global territories, Club L has experienced phenomenal, ongoing growth.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Join the Club and become one of our Affiliates and earn commission when you promote your favourite new pieces.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Club L London Offers:&nbsp;<\/span><\/h4><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Up to 7% commission (excluding VAT and P&amp;P on the final transaction amount after all discounts have been applied).<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">30 Day cookie length.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Industry standard sized banners \u2013 updated regularly using the latest creative.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Regular updated feeds with a variety of new in products from all collections.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Affiliate newsletter updates with trends, news and the latest offers.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Opportunities to run exclusive partnerships with Club L London.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">An Excellent AOV and conversion rate<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Please note: VAT and Delivery charges do not qualify for commission.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">PPC<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please note Club L London will not pay commission to affiliates carrying out any unauthorised brand bidding and brand + product bidding for the duration the bidding takes place. Publishers are not permitted to bid on the brand or brand and product terms.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Validations<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All commissions will be validated on a 45&nbsp;day period and Club L London reserves the right to decline commission on all returned goods.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Branding<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please ensure you are&nbsp;use&nbsp;the most up to date logo and branding which is used on the network profile - if you need different sizes please get in touch.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Campaigns<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Club L London may share details of upcoming campaigns or promotions with its affiliates under embargo. Affiliates must not share this information publicly or with any other company ahead of any launch date when an embargo is in place. Doing so will result in loss of commissions and\/or termination from the programme.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Contact Us<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Got a question or need some more information? Feel free to get in touch with our Affiliate team at&nbsp;<a href=\"mailto:affilates@clubllondon.com\" style=\"margin: 0px; padding: 0px; cursor: pointer; transition-property: color; transition-duration: 0.2s;\">affilates@clubllondon.com<\/a><\/p><\/div>","program_policies":"<h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Terms and Conditions<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please note that failure to comply with these terms and conditions could result in your relationship being terminated and\/or any commissions earned being reversed.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Examples include, but are not limited to the following:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Voucher Code \/ Discount Code&nbsp;Affiliates<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All voucher code affiliates are expected to adhere to the below:<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Club L London asks that affiliates adhere to the new guidelines from the Internet Advertising Bureau Affiliate Marketing Council (IAB AMC). Therefore, the terms &amp; conditions of this affiliate programme have been set to reflect these guidelines:<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">1. Using \"Click to Reveal\" when there is no valid or current code present is not permitted for affiliate publishers using \"Click to Reveal\" to show any deals \/ offers \/ sales instead of vouchers.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2. Voucher code affiliate publishers must clearly detail the voucher offer that will be revealed by the click.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">3. A valid code or promotion is defined as a code that has been legitimately issued by Club L London for use by affiliates and not a code that has been issued to consumers direct. This code or promotion will have an activation date and where necessary a deactivation date.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">4. Voucher code directories must contain clear categorisation and separation between deals \/ offers \/ sales and discount codes.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5. Publishers are not allowed to promote\/display any student discount offer unless previously agreed with the Club L London team directly.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">6. Publishers are not permitted to promote\/display Club L London\u2019s Black Friday\/Cyber Monday\/ Cyber Week offers unless previously agreed with the Club L London team directly.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Furthermore, the following offers cannot be promoted\/displayed:<\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">App Only<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Email\/Social (those are exclusive to the specific channel)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Codes that belong to other publishers<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Student discounts (unless previously agreed with the Club L London team directly).<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Codes\/offers that haven\u2019t been specifically passed to you by Club L London\/Awin directly.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">Creative \/ Branding<\/span><\/h4><br style=\"margin: 0px; padding: 0px;\">Affiliates may not alter any of the creative or text links available through the Awin&nbsp;interface. Affiliates are also requested not to hardcode banners into their sites, so updates made to those through Awin&nbsp;may take immediate effect.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Anyone found infringing on these terms will receive a warning and may have commissions reversed. We reserve the right to withhold commission during this time. Continuous infringement of these terms will result in suspension.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please refer to brand guidelines to ensure you are representing the brand in the correct way<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">I-frames<\/span><\/h4><br style=\"margin: 0px; padding: 0px;\">Affiliates may not put the Club L London website into frames or use masked URLs.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">Product Feed&nbsp;<\/span><\/h4><br style=\"margin: 0px; padding: 0px;\">The Club L London data feed with up-to-the-minute pricing information will be refreshed each day.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Affiliates are requested to make every effort to maintain Club L London\u2019s most current pricing information in their promotions.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">1. Pay Per Click search activity<\/span><\/h4><br style=\"margin: 0px; padding: 0px;\">Affiliates are not permitted to carry out any PPC search activity directing traffic to Club L London except by special arrangement.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Affiliates generating traffic to their own sites must also abide by the following rules.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">a. Using the Club L London brand term in the sub folder of the display URL (eg www.affiliate.com\/ ClubLLondon) \u2013 Not Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">b. Using the Club L London brand term in the sub domain of the display URL (eg www. ClubLLondon.affiliate.com) \u2013 Not Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">c. Using the Club L London brand or a misspelling of the Club L London brand in the display URL (eg www.ClubLondon.com) \u2013 Not Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">d. Using the Club L London brand in the ad title \u2013 Not Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">e. Using the Club L London brand in the ad text \u2013 Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">f. Bid on the brand term \u201cClub L London\u201d \u2013 Not Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">g. Bid on misspellings or extensions of the brand (eg \u201cClub London) \u2013 Not Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">h. Bid on Club L London brand + generic terms (eg \u201cClub L London Dresses\u201d) - Not Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">i. Bid on the advertisers URL www.ClubLLondon.com) \u2013 Not Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">j. Show adverts on competitors\u2019 brands \u2013 Not Allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">k. Please note affiliates are NOT allowed to bid on any variations of the brand name Club L London. Bidding on any brand sold on Club L London is also not allowed<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">l. Club L London and common misspelling should be added as negative terms to all affiliate paid search campaigns.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">2. Discount code \/ voucher code websites<\/span><\/h4><br style=\"margin: 0px; padding: 0px;\">As standard all voucher code use needs to comply with the official IAB guidelines which can be found here:<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">http:\/\/www.iabuk.net\/en\/1\/iabsaffiliatemarketingcouncillaunchescodeofbestpractice110808.mxs<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">a. Publishers may only use discount codes which have been supplied to them by Awin&nbsp;or Club L London directly. Please apply to Awin&nbsp;or the detailed contact at Club L London to obtain authorised codes for the Club L London programme.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">b. Publishers must not display made up \/ invented discount codes on their site(s) or display discount codes that were intended for use in other channels or for other online publishers.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b1. Publishers are not allowed to promote\/display any student discount offer unless previously agreed with the Club L London team directly.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">c. Under no circumstances are publishers allowed to surreptitiously use i-frames to set Awin&nbsp;cookies onto a user\u2019s computer.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">d. Discount code publishers with websites that encourage users to \u201cclick here to reveal offer \/ code\u201d thus setting an Awin&nbsp;cookie can only use this function if a voucher code exists for the Club L London programme. If there is no voucher code available for the Club L London programme publishers must not use this method, as it leads to a poor user experience for potential Club L London customers and can cause customer service issues.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">e. If a discount code has been issued to publishers and it has an expiry date the publisher must clearly display on its website(s) the expiry date of this discount so that the user can decide whether they want to go ahead and click the publisher\u2019s link.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">f. If publishers wish to maintain expired discount codes on their sites for search engine optimisation reasons, they must display clear notification to the user that the discount has expired. This notification must be located right next to the expired discount code. The font size must be no smaller than the site(s) body text and the colour used must contrast clearly with the background It is not acceptable for the notification to be displayed a significant distance from the expired code.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><h4>4. Email Marketing<\/h4><br style=\"margin: 0px; padding: 0px;\">a. All email marketing must be signed off by Club L London and the account management team.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">5. Linking<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">a. Publishers are allowed to deeplink to a chosen offer or category on the Club L London site<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">b. Linking through splash pages is not permitted (i.e. those on the Club L London front page) as this interferes with the analytics package that is currently in place. Therefore, an affiliate tracking link must not include the splash page parameter (e.g. ?cm_re=Splash%20Box%20-_-Splash%20Box%205%20-_-Sale%20Dress) &nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">3. Cashback sites<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please note that use of any promotional\/voucher codes that haven\u2019t been issued to you by Club L London or Awin, will result in the sales being declined. This includes voucher codes that were exclusively given to another affiliate or codes from other online sources.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">In instances where exclusive codes have been issued to the cashback site directly by Club L London or Awin, the user will be eligible to earn cashback.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">For any sites that display commission rates, please ensure that this is clearly stated on your websites to ensure customers\/members are aware of these T&amp;C!<\/span><\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">4. Google Shopping Ads<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Please note that bidding on Bing and Google Shopping is not permitted by affiliates.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Affiliate Approvals&nbsp;<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All affiliate sites are audited on sign up to ensure any brand compliance issue that may exist are met. Any affiliates without a working URL will be rejected.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">Validations<\/span><\/h4><br style=\"margin: 0px; padding: 0px;\">All commissions will be validated on a 45 day period and Club L London reserves the right to claw back commission on all returned goods.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We reserve the right to modify this Agreement at any time as demanded by the business without prior notice.&nbsp;&nbsp;<\/p>","url":"https:\/\/www.clubllondon.com.au","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=31521&id=1263017","type":"api","created_at":"2023-03-21T07:06:05.000000Z","updated_at":"2025-10-15T13:24:30.000000Z","deleted_at":null,"is_show":0,"is_request__process":0,"is_active":1,"custom_domain":"clubllondon.com.au"}}  
