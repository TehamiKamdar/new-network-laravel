[2025-11-22 10:40:37] production.INFO: {"id":"0e2e486d-d49a-40d4-bb5e-afd509ed5624","publisher_id":"5042526f-364b-4d9c-991f-00bb5c6d33f9","website_id":"476ffce2-b33d-4632-9e7e-38d9308de61b","advertiser_id":"6f1a2aef-3d27-453d-b198-aa33e7bc9915","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=11707&awinaffid=1263017&campaign=A-ROSA+Flussschiff+GmbH&clickref=5042526f-364b-4d9c-991f-00bb5c6d33f9&clickref2=476ffce2-b33d-4632-9e7e-38d9308de61b&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.arosa-cruises.com%2Friver-cruises%2Fwonderful-time%2Ffamily-cruises.html%3Futm_source%3Dawin%26utm_medium%3Dtext%26utm_campaign%3D09%2520%257C%2520Awin%2520%257C%25202021%2520%257C%2520Deeplink%26utm_content%3Ddeeplink&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/S22lhAHM","tracking_url_long":null,"sub_id":null,"hits":13,"unique_visitor":13,"advertiser":{"id":"6f1a2aef-3d27-453d-b198-aa33e7bc9915","user_id":null,"network_source_id":null,"advertiser_id":11707,"api_advertiser_id":"6f1a2aef-3d27-453d-b198-aa33e7bc9915","sid":26496103,"name":"A-ROSA Flussschiff GmbH","currency_code":"EUR","average_payment_time":"138","validation_days":"35","epc":"0.47","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/arosaflussschiffgmbh.png","fetch_logo_url":null,"is_fetchable_logo":0,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"8","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":0,"country_full_name":["Germany"],"categories":["7b67df5e-55f2-441e-95c6-e55dcb54d33e"],"primary_regions":["DE"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["*.a-rosa.de","a-rosa.de"],"short_description":"A-ROSA bietet Premium Kreuzfahrten auf Donau, Rhein\/Main\/Mosel, Rh\u00f4ne\/Sa\u00f4ne, Seine und auf dem Douro in Portugal an. Werden Sie Partner eines starken Netzwerkes und sichern Sie sich Ihre Provision in H\u00f6he von bis zu 8% f\u00fcr jeden Sale.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">A-ROSA Flussschiff GmbH Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Die A-ROSA Flussschiff GmbH mit Sitz in Rostock ist mit ihren modernen Kreuzfahrtschiffen auf die Fahrtgebiete von Donau, Rhein\/Main\/Mosel, Rh\u00f4ne\/Sa\u00f4ne. Seine sowie Douro spezialisiert und bietet hier vielf\u00e4ltige St\u00e4dte- und Naturreisen an.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Als Markenanbieter schafft A-ROSA l\u00e4ssig-deluxe Urlaubserlebnisse aus einer Hand mit Schwerpunkt Genuss, Wellness, Sport und Erleben.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Mit einem abwechslungsreichen Programm \u2013 auch f\u00fcr Familien \u2013 und moderner Ausstattung an Bord, laden die elf Premium-Schiffe zum Entspannen, Genie\u00dfen und Erleben ein. Mit dem Tarif \u201ePremium alles inklusive\u201c k\u00f6nnen die G\u00e4ste sich zur\u00fccklehnen und verw\u00f6hnen lassen. Denn hier trifft maximaler Genuss auf maximalen Komfort: Mit abwechslungsreichen Mahlzeiten, hochwertigen Getr\u00e4nken, Nutzung des SPA- und Fitnessbereichs und vielen weiteren Inklusivleistungen f\u00fcr einen rundum-sorglos-Urlaub.<\/p><\/div>","program_policies":"<h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Herzlich Willkommen im neuen A-ROSA Affiliate Programm<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Beachten Sie als Publisher die folgenden Programmbedingungen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">1.&nbsp;&nbsp; &nbsp;Highlights bei A-ROSA<\/span><\/h4>Die A-ROSA Flussschiff GmbH ist mit ihren modernen Kreuzfahrtschiffen auf die Fahrtgebiete von Donau, Rhein\/Main\/Mosel,&nbsp;Rh\u00f4ne\/Sa\u00f4ne, Seine sowie Douro spezialisiert und bietet hier vielf\u00e4ltige St\u00e4dte- und Naturreisen an. Mit einem abwechslungsreichen Programm auch f\u00fcr Familien (Sondertarife f\u00fcr Familien mit Kinder bis 15 Jahre)&nbsp;und moderner Ausstattung an Bord, laden die 13 Premium Schiffe zum Entspannen, Genie\u00dfen und Erleben ein. Mit dem Tarif \u201ePremium alles inklusive\u201c k\u00f6nnen die G\u00e4ste sich zur\u00fccklehnen und verw\u00f6hnen lassen. Denn hier trifft maximaler Genuss auf maximalen Komfort: Abwechslungsreiche Buffets mit Live-Cooking, hochwertige Getr\u00e4nke, Nutzung des SPA-, Beauty- und Fitnessbereichs und vielen weiteren Inklusivleistungen f\u00fcr einen Rundum-sorglos Urlaub.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">A-ROSA ist ein dynamisches und auf Wachstum ausgerichtetes Kreuzfahrtunternehmen. Gerade Familien mit Kindern, Liebhaber von St\u00e4dtereisen sowie Genie\u00dfer und Feinschmecker sind bei uns genau richtig. A-ROSA Markenbotschafterin ist die bekannte Schauspielerin und Musikerin Yvonne Catterfeld. Zum wiederholten Mal konnte die A-ROSA Flussschiff GmbH im Jahr 2018 ihre Kunden \u00fcberzeugen und gewinnt den ersten Platz beim Deutschen Fairness-Preis in der Kategorie \u201eAnbieter Flusskreuzfahrten\u201c.&nbsp;Die Marke z\u00e4hlt zu den bekanntesten in der Branche.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Mit Start des Programms als Premium Marke ist A-ROSA der erste Anbieter von Flusskreuzfahrten im AWIN Netzwerk.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Wir bieten Ihnen als Publisher folgende Anreize zur Vermarktung:<\/span><br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Stets aktuelle Produktdaten aus unseren Reisen<br style=\"margin: 0px; padding: 0px;\">-&nbsp; &nbsp; bis zu 8 % Verg\u00fctung bei Sales (Reisebuchungen)<br style=\"margin: 0px; padding: 0px;\">-&nbsp; &nbsp; 30 Tage Cookie Laufzeit<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Regelm\u00e4\u00dfige Aktionsreisen f\u00fcr Kunden (z.B. Valentinstag, Fr\u00fchbucher, per E-Mailing u.a.)<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Aktuelle Angebote im Shop jederzeit verf\u00fcgbar<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Premium-Partnerschaften f\u00fcr Publisher m\u00f6glich<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp;&nbsp; Etwa 30&nbsp;Tage Bearbeitung f\u00fcr Ihre Transaktion<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Anteilige fr\u00fchzeitige Sale-Aussch\u00fcttung<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Gro\u00dfe Auswahl an themenspezifisch kategorisierten Werbemitteln (zunehmend im Aufbau)<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Zugang zu kostenlosen A-ROSA Webinaren und Schulungsunterlagen<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Umfassende und pers\u00f6nliche Publisher Betreuung und Kommunikation<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">2.&nbsp;&nbsp; &nbsp;Verg\u00fctung f\u00fcr Publisher<\/span><\/h4>Zum Start unseres Advertiser Programms im AWIN Netzwerk, gew\u00e4hren wir eine Provision in H\u00f6he von bis zu 8%.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Die A-ROSA Verg\u00fctung erfolgt nur auf best\u00e4tigte Sales (Reisebuchung A-ROSA Kreuzfahrt zum \u00f6ffentlich verf\u00fcgbaren Marktpreis). Die Verg\u00fctung ist unabh\u00e4ngig von der Dauer der gebuchten Kreuzfahrt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Eine Verg\u00fctung findet nur dann statt, wenn die Buchung auf a-rosa.de\/flusskreuzfahrten (Bereich Kreuzfahrten) nachweisbar dem Publisher zuzuordnen ist und aufgrund der beim Publisher eingesetzten A-ROSA Werbemittel zustande gekommen ist. Die Cookie-Laufzeit von 30 Tagen wird hierbei ber\u00fccksichtigt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Die Verg\u00fctung wird erst angewiesen, wenn der Sale durch A-ROSA best\u00e4tigt wurde und der Gast die Anzahlung lt. A-ROSA AGB f\u00fcr seine Buchung get\u00e4tigt hat. Bei stornierten Buchungen wird keine Provision ausgesch\u00fcttet.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">3.&nbsp;&nbsp; &nbsp;Teilnahmebedingungen f\u00fcr Publisher<\/span><\/h4>Wir lassen von uns nur gepr\u00fcfte Publisher zum A-ROSA Programm zu, welche zudem aktiv im AWIN&nbsp;Netzwerk t\u00e4tig sein m\u00fcssen.<br style=\"margin: 0px; padding: 0px;\">Wir behalten uns vor, Publisher umgehend aus unserem Programm auszuschlie\u00dfen, sofern uns Gr\u00fcnde vorliegen die eine weitere Zusammenarbeit versagen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Ausgeschlossen sind und werden Publisher, die:<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;gegen strafrechtliche Vorschriften versto\u00dfen (z.B. Verteilung pornografischer und verfassungsfeindlicher Schriften, Aufruf zu Straftaten, Betrug)<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;keine Pr\u00fcfung der eigenen Inhalte zulassen<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;kein g\u00fcltiges Impressum auf Ihrer Webseite haben<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Weiterleitungen zu anderen URL\u00b4s benutzen<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;in Suchmaschinen und Social Media Kan\u00e4len geblockt sind<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;gegen folgende Aktivit\u00e4ten versto\u00dfen: Brand-Bidding, Ad-Hijacking, Cookie Dropping, Fake Bestellungen, Jede andere Art von Betrug<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Zuwiderhandlungen haben den umgehenden Ausschluss aus dem A-ROSA Partnerprogramm zur Folge. Bei Verst\u00f6\u00dfen entf\u00e4llt der Provisionsanspruch. Unber\u00fchrt davon bleiben weitere rechtliche Schritte.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">4.&nbsp;&nbsp; &nbsp;Verwendung von Werbemittel &amp; Publikation<\/span><\/h4>Dem Publisher ist es erlaubt die im AWIN&nbsp;Partnerprogramm zur Verf\u00fcgung stehenden A-ROSA Werbemittel&nbsp; zu verwenden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Nicht erlaubt ist die Verwendung von<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Anzeigen jeglicher Art (z.B. Print, AdWords, Bing)<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Verwendung von Bild- , Ton- und Werbematerial anderweitiger Herkunft<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Weiterleitungen auf eigene Partnerseiten<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Die Verg\u00fctung erfolgt nur aufgrund einer Buchung auf a-rosa.de\/flusskreuzfahrten (Bereich Kreuzfahrten) durch ein entsprechendes eingesetztes und freigegebenes Werbemittel durch A-ROSA.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">5.&nbsp;&nbsp; &nbsp;\u00c4nderungen im Partnerprogramm<\/span><\/h4>Dem Publisher werden \u00c4nderungen im Partnerprogramm rechtzeitig 7 Tage vorher bekanntgegeben:<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Schlie\u00dfen einer Kampagne oder des Programms<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Konditions\u00e4nderungen jeglicher Art<br style=\"margin: 0px; padding: 0px;\">-&nbsp;&nbsp; &nbsp;Technische \u00c4nderungen wie Erreichbarkeit, Werbemittel<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><h4><span style=\"margin: 0px; padding: 0px;\">6.&nbsp;&nbsp; &nbsp;Kontakt<\/span><\/h4>Wenden Sie sich mit Ihren Fragen, W\u00fcnschen und Anregungen direkt an<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">A-ROSA Affiliate Team<br style=\"margin: 0px; padding: 0px;\">Herr Alexander Brenncke<br style=\"margin: 0px; padding: 0px;\">E-Mail: online@a-rosa.de<br style=\"margin: 0px; padding: 0px;\">Telefon: 0381 \u2013 400 40 236<\/p>","url":"https:\/\/www.a-rosa.de\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=11707&id=1263017","type":"api","created_at":"2023-03-21T07:05:14.000000Z","updated_at":"2025-11-17T09:18:43.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":0,"custom_domain":"a-rosa.de"}}  
