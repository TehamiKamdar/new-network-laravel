[2025-11-22 06:30:24] production.INFO: {"id":"a2da2b65-6820-4a41-96ea-79456fd6a1a5","publisher_id":"aeed784e-eef1-4517-8d88-b52cdb9d4676","website_id":"99a2e5f0-799b-40fc-a8d4-0f9d117f4552","advertiser_id":"5e7bcbf0-2d88-4f89-8ae8-e96114c2a550","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=31736&id=1263017&campaign=Aphrolux+Accessories&clickref=aeed784e-eef1-4517-8d88-b52cdb9d4676&clickref2=99a2e5f0-799b-40fc-a8d4-0f9d117f4552&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Faphroluxaccessories.com%2Fcollections%2Fgold-plated-jewellery&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/bKyyp7B1","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=38053696&linkaffid=35243533&ued=https%3A%2F%2Faphroluxaccessories.com%2Fcollections%2Fgold-plated-jewellery","sub_id":null,"hits":9,"unique_visitor":7,"advertiser":{"id":"5e7bcbf0-2d88-4f89-8ae8-e96114c2a550","user_id":null,"network_source_id":null,"advertiser_id":31736,"api_advertiser_id":"5e7bcbf0-2d88-4f89-8ae8-e96114c2a550","sid":38053696,"name":"Aphrolux Accessories","currency_code":"GBP","average_payment_time":null,"validation_days":null,"epc":null,"tags":null,"offer_type":null,"source":"Awin","logo":"storage\/aphroluxaccessories.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/31736.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":0,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"10","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":0,"country_full_name":["United Kingdom"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["aphroluxaccessories.com","*.aphroluxaccessories.com"],"short_description":"Welcome to Aphrolux! The home of high-quality jewellery and hair accessories inspired by rich cultures throughout Africa and the Caribbean. We are committed to providing the finest level of service.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">About Aphrolux<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Founded in the UK in 2022, Aphrolux was created to share our passion for high-quality jewellery that represents African and Caribbean cultures. Our jewellery is absolutely one-of-a-kind, always of the finest quality, and obtained responsibly. We provide the best quality pieces set mostly in tarnish-free steel, sterling silver and gold vermeil, at an accessible price by, eliminating the middleman and purchasing directly from suppliers, bringing stunning pieces to a new generation of jewellery&nbsp;enthusiasts.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We at Aphrolux Accessories believe in thanking Mother Nature and celebrating the colourful cultures from Africa and the Caribbean.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We look forward to partnering with amazing publishes who will earn good commissions while promoting our brand and generating business!<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">About Aphrolux costumers:<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Average basket order \u00a350+<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Costumers have multiple ways to check out and spread the cost of their purchase (LayBuy, Clearpay, Klarna, Paypal etc.)&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We also offer free delivery on orders over \u00a340 and regularly offer free gifts&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Who is our programme for?<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We welcome all publishers from content creators to bloggers to even PR outlets. If this describes you, get in touch with us to learn more about our special programme that will provide you access to a budget, samples, and commission as you grow in a just manner.<\/p>","program_policies":"<h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Commissions and publishers&nbsp;<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We offer a flat 20% commission to on all successful (checked out and paid transactions)&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Commissions will not be validated on transactions that have been returned and refunded. If an order is partially refunded we will manually validate the commissions. Most transactions will be validated within 30 days. In this instance will pay the 10% commission based on the value of the order after the refunded amount.&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Tracking and Cookies&nbsp;<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">As well as using analytics provided by AWIN we also use Google analytics and other tracking programmes to help us with the process of validating transactions. We use many forms of digital marketing such as email marketing, paid social ads and retargeting. Commissions will not be validated for transactions if we can clearly see the sale came from another source of digital marketing. We employ technologies to monitor the behaviour of visitors to our website.&nbsp;<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Discount codes&nbsp;<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Throughout the year we offer a variety of &nbsp;discount codes and offers inline with our promotional calendar. If customer a uses one of these discount codes for their transaction we will pay the publisher 20% commission on the order value after the discount code has been applied. Only discount codes, sales, and deals announced by an Aphrolux account manager should be promoted by partners.<\/p><h4 style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Promotions on Social Media&nbsp;<\/span><\/h4><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Only discount codes, sales, and deals announced by an Aphrolux account manager via AWIN should be promoted by partners.<\/p>","url":"https:\/\/aphroluxaccessories.com\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=31736&id=1263017","type":"api","created_at":"2023-03-21T07:06:05.000000Z","updated_at":"2025-04-30T09:43:00.000000Z","deleted_at":null,"is_show":0,"is_request__process":0,"is_active":0,"custom_domain":"aphroluxaccessories.com"}}  
