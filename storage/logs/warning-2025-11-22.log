[2025-11-22 06:25:31] production.INFO: {"id":"c4f69903-ec25-4e51-950a-b2347b7ab490","publisher_id":"aeed784e-eef1-4517-8d88-b52cdb9d4676","website_id":"99a2e5f0-799b-40fc-a8d4-0f9d117f4552","advertiser_id":"d1d19df4-66f8-4a0f-900b-a1ee72d925b9","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=25446&id=1263017&campaign=Buy+Sheds+Direct&clickref=aeed784e-eef1-4517-8d88-b52cdb9d4676&clickref2=99a2e5f0-799b-40fc-a8d4-0f9d117f4552&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.buyshedsdirect.co.uk%2Fchildrens-playhouses&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/8a0W9l2T","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=66567542&linkaffid=35243533&ued=https%3A%2F%2Fwww.buyshedsdirect.co.uk%2Fchildrens-playhouses","sub_id":null,"hits":6,"unique_visitor":5,"landing_url":"https:\/\/www.buyshedsdirect.co.uk\/childrens-playhouses","advertiser":{"id":"d1d19df4-66f8-4a0f-900b-a1ee72d925b9","user_id":null,"network_source_id":null,"advertiser_id":25446,"api_advertiser_id":"d1d19df4-66f8-4a0f-900b-a1ee72d925b9","sid":66567542,"name":"Buy Sheds Direct","currency_code":"GBP","average_payment_time":"83","validation_days":"1","epc":"1.29","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/buyshedsdirect.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/25446.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"5.5","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["United Kingdom"],"categories":["4c1e7c4d-c90b-46b3-ab29-528a2c090a95","9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":[],"short_description":"As one of the UK's leading suppliers of garden sheds, log cabins, garden storage, summer houses, and more, Buy Sheds Direct has everything you need for your outdoor space.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Buy Sheds Direct Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>About Buy Sheds Direct.<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Established in 2005, we one of the UK's leading online retailers of garden sheds, garden buildings, outdoor storage and associated products.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">As specialists in garden buildings and garden storage, we offer a vast range of sizes, designs and specifications. Working closely with many leading brands such as Yardmaster, Forest Garden, Shire, Keter, Biohort&nbsp;and Palmako, we offer high quality products for every garden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">As well as sheds, workshops, garages, summer houses and log cabins, we are also delighted to offer playhouses, garden chests, bin stores, bike sheds, garden furniture, planters, fencing, decking, garden arches, gazebos, log stores, greenhouses, play equipment, outdoor heating and more!&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We also work with a national network of carriers to deliver products to customers door free of charge to mainland UK - including Pick A Day Delivery on a range of products*.&nbsp; Many of our manufacturers also offer an installation service for a fast,&nbsp;professional assembly of many chosen products.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Why join us?<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">5% of net sale base commission (please note basket value commission rates)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">High average order value over \u00a3500<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Over 250,000 unique visitors per month&nbsp;<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">An up to date product feed&nbsp;containing images, descriptions and deep linking urls<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">A great range of creatives available<\/li><\/ul><\/div>","program_policies":"<p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b><span style=\"margin: 0px; padding: 0px;\">PPC Policy<\/span><br style=\"margin: 0px; padding: 0px;\"><\/b>Please note Buy Sheds Direct do not support brand name bidding nor bidding on brand name terms or misspellings.<br style=\"margin: 0px; padding: 0px;\">PPC affiliates should add the Buy Sheds Direct brand name and its permutations into their negative keyword list to avoid their ads showing when a brand + generic term is searched for. Commissions will be declined if an affiliate does not comply with PPC terms.<br style=\"margin: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><b><span style=\"margin: 0px; padding: 0px;\">Discount Codes<\/span><br style=\"margin: 0px; padding: 0px;\"><\/b>Affiliates may only promote discount codes provided exclusively for your site and not taken from another source.<span style=\"margin: 0px; padding: 0px;\">&nbsp;Buy Sheds Direct<\/span>&nbsp;will provide all codes suitable for affiliate use via email, the Awin&nbsp;News Manager, the Offers Blog or via their affiliate manager. If an affiliate uses a code not issued for affiliate use, then commissions will be declined. Buy Sheds Direct reserves the right to withdraw a voucher code or stop any promotional activity at any time.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Validation of Sales where a Voucher Code has been used<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Buy Sheds Direct reserve the right to decline any sales that have been tracked with an unauthorised voucher code whether this code was promoted on the site or not.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Domain Restrictions<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates may not use any domain owned by Buy Sheds Direct for PPC linking without express written permission.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates are asked not to register domains which are similar or misspellings of Buy Sheds Direct brand. Any activity of this kind on the campaign will result in commissions being declined.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">The use of the domain Buy Sheds Direct and variations is strictly forbidden in any ad copy including display URL, and the use of the term \u2018official site\u2019 in your ad copy is forbidden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates wishing to promote Buy Sheds Direct through search engine marketing via a landing page should first contact the account management team to discuss this.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Creatives<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates may not alter any of the creative or text links available through the Affiliate Window interface. Affiliates are also requested not to hardcode banners into their sites, so updates made to those available through Affiliate Window may take immediate effect.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Validations<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Buy Sheds Direct reserve the right to reject any transactions they deem to be illegitimate, fraudulent or otherwise non-valid.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Delivery<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Most of our products are available for delivery to all areas of mainland UK. We do not ship internationally.<\/p>","url":"https:\/\/www.buyshedsdirect.co.uk\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=25446&id=1263017","type":"api","created_at":"2023-03-21T07:06:00.000000Z","updated_at":"2025-04-18T10:56:42.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":1,"custom_domain":"buyshedsdirect.co.uk"}}  
