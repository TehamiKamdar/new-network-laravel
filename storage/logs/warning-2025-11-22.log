[2025-11-22 06:33:34] production.INFO: {"id":6,"publisher_id":"aeed784e-eef1-4517-8d88-b52cdb9d4676","website_id":"99a2e5f0-799b-40fc-a8d4-0f9d117f4552","advertiser_id":"3d206038-ad41-43a2-bac7-b209fac44b7d","click_through_url":"https:\/\/click.linksynergy.com\/deeplink?id=HrVMRnxcH3E&mid=45726&murl=https:\/\/www.eurocamp.co.uk\/special-offers\/early-booking-offer&u1=99a2e5f0-799b-40fc-a8d4-0f9d117f4552","tracking_url":null,"tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=14005120&linkaffid=35243533&ued=https%3A%2F%2Fwww.eurocamp.co.uk%2Fspecial-offers%2Fearly-booking-offer","sub_id":null,"hits":1,"unique_visitor":1,"advertiser":{"id":"3d206038-ad41-43a2-bac7-b209fac44b7d","user_id":null,"network_source_id":null,"advertiser_id":45726,"api_advertiser_id":"3d206038-ad41-43a2-bac7-b209fac44b7d","sid":14005120,"name":"Eurocamp","currency_code":null,"average_payment_time":null,"validation_days":null,"epc":null,"tags":null,"offer_type":null,"source":"Rakuten","logo":null,"fetch_logo_url":"https:\/\/merchant.linksynergy.com\/fs\/logo\/lg_45726.jpg","is_fetchable_logo":1,"fetch_logo_error":null,"status":0,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"4","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":0,"country_full_name":null,"categories":["d60fc07d-ce1c-408c-888b-59114d593ba0"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813","211f5228-42f6-4197-a90c-a0833df78b01","5f2ce3f8-a7c5-4939-ab0e-9855a2713450"],"valid_domains":null,"short_description":"Eurocamp are the leader in outdoor holidays & help over 500,000 people plan amazing trips each year. We\u2019ve 400+ quality parcs across Europe & offer more flexibility than other providers, with no fixed arrival\/departure dates & numerous travel options.","description":"<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" class=\"deviceWidth\" style=\"font-family: &quot;Times New Roman&quot;; max-width: 600px; border: 1px solid rgb(114, 191, 68);\"><tbody><tr><td><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"max-width: 600px;\"><tbody><tr><td align=\"center\"><br><\/td><\/tr><tr><td align=\"center\" valign=\"top\"><div style=\"display: inline-block; min-width: 100px; vertical-align: top; width: 600px;\"><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><\/tbody><\/table><\/div><\/td><\/tr><tr><td><table cellpadding=\"8\" cellspacing=\"5\" width=\"100%\"><tbody><tr><td align=\"center\" bgcolor=\"#ffffff\" style=\"padding: 30px 50px;\"><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 600px;\"><tbody><tr><td colspan=\"2\" align=\"center\" style=\"font-family: Poppins, Arial, Helvetica, sans-serif; font-size: 28px; color: rgb(0, 0, 0); margin: 0px; padding: 10px; letter-spacing: 1px; text-transform: uppercase; border-bottom: 1px solid rgb(114, 191, 68);\"><strong>WELCOME TO THE EUROCAMP AFFILIATE PROGRAM<\/strong><\/td><\/tr><tr><td colspan=\"2\" bgcolor=\"#ffffff\" align=\"center\" style=\"font-family: Poppins, Arial, Helvetica, sans-serif; font-size: 15px; color: rgb(0, 0, 0); line-height: 20px; padding: 5px;\"><br>Now that you\u2019ve joined the Eurocamp family, we\u2019ll keep you up to date through our monthly newsletters, which are packed with all our lovely offers and news. Plus you\u2019ll have plenty of support from the team at Eurocamp (<a href=\"mailto:affiliates@eurocamp.co.uk\" target=\"_blank\" style=\"color: rgb(62, 62, 62); border-bottom: 2px solid rgb(0, 0, 0);\">affiliates@eurocamp.co.uk<\/a>) and our Account Manager at Rakuten (<a href=\"mailto:ra-eurocamp@mail.rakuten.com\" target=\"_blank\" style=\"color: rgb(62, 62, 62); border-bottom: 2px solid rgb(0, 0, 0);\">ra-eurocamp@mail.rakuten.com<\/a>).<br><br>Have a look around our&nbsp;<a href=\"https:\/\/www.eurocamp.co.uk\/\" target=\"_blank\" style=\"color: rgb(62, 62, 62); border-bottom: 2px solid rgb(0, 0, 0);\">website<\/a>&nbsp;to really get to know us and feel free to get in touch with any questions.<br><strong><br>ABOUT US<\/strong><br><br>We\u2019re not just a holiday company...<br><br>We've spent over 45 years helping families create holidays that redefine quality time. Here's how we do it:<br><ol style=\"text-align: left;\"><li>We offer the biggest choice of outdoor holidays across Europe with over 175 specially selected parcs, so no matter what you\u2019re perfect holiday looks like we\u2019ll have a destination to match<\/li><li>Experience the kind of accommodation that can't be found anywhere else, from Safari and Classic Tents, to modern Holiday Homes<\/li><li>Leave fixed arrival and departure dates behind; it's about travel and timings that suit you<\/li><li>It's your holiday, not ours, so we won't tell you what to do, but we can show you the possibilities<\/li><li>On parc activities ranging from canoeing to horse riding. We also offer free, age-specific kids\u2019 clubs, with bespoke activities like zorbing and hover boarding.<\/li><\/ol><strong><br>PROGRAM DETAILS<\/strong><ul style=\"text-align: left;\"><li>Attractive basic commission of&nbsp;<strong>4% on every consumed booking<\/strong><\/li><li>We use a&nbsp;<strong>28 day cookie-window<\/strong><\/li><li>High AOV ranges between&nbsp;<strong>\u00a3900 and \u00a31200<\/strong><\/li><li>Full range of creative available<\/li><li>Programme of incentives including free holiday giveaways and increased commissions.<\/li><li>Special offer notifications and monthly newsletters to keep you up to date on the latest.<\/li><\/ul><strong><br>TERMS AND CONDITIONS<\/strong><ul style=\"text-align: left;\"><li>Please take note that Eurocamp will not accept any sales from traffic generated using paid search on the terms \u201cEurocamp\u201d and any misspellings. If affiliates are running any PPC campaigns, then they must not use Eurocamp in their display URL as part of their ads.<\/li><li>Publishers must not register or use a URL containing Eurocamp, misspells or derivatives in the domain name (e.g.&nbsp;<a href=\"http:\/\/www.eurocampparks.net\/\" target=\"_blank\" style=\"color: rgb(62, 62, 62); border-bottom: 2px solid rgb(0, 0, 0);\">eurocampparks.net<\/a>) without express permission.<\/li><li>Publishers must not use the brand name, misspells or derivatives in the sub domains (<a href=\"http:\/\/www.eurocamp.yourdomain.co.uk\/\" target=\"_blank\" style=\"color: rgb(62, 62, 62); border-bottom: 2px solid rgb(0, 0, 0);\">eurocamp.yourdomain.co.uk<\/a>) without express permission.<\/li><li>Publishers are permitted to use the brand name in sub folders (e.g. www.yourdomain.co.uk\/eurocamp).<\/li><li>Past employees of Eurocamp, Holidaybreak or Greenbank Holidays must have written permission to participate in the affiliate programme.<\/li><li>Commission is only payable on UK Eurocamp bookings and will only be paid once the customer has actually departed for their holiday. Bookings for Eurocamp Independent are not eligible for commission.<\/li><li>Transaction Queries: Please note that sales are validated on consumption, that is after the holiday is taken. Therefore, unless untracked and invalid we are unable to fully validate transaction queries until after the holiday has been taken.<\/li><li>Exclusive codes: Affiliates may not use discount codes unless permission has been given to the affiliate. Eurocamp has the right to decline commission from any bookings made using an unauthorised discount code.<\/li><\/ul><\/td><\/tr><\/tbody><\/table><\/td><\/tr><\/tbody><\/table><\/td><\/tr><tr><td height=\"62\" align=\"center\" style=\"background-c