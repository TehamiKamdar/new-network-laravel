[2025-11-22 06:31:12] production.INFO: {"id":"8bf5ed64-6cb8-4c2f-ab50-9e5670ac9c62","publisher_id":"aeed784e-eef1-4517-8d88-b52cdb9d4676","website_id":"99a2e5f0-799b-40fc-a8d4-0f9d117f4552","advertiser_id":"aed1b237-dbbf-4ad1-b932-9af7f37b4b13","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=22855&id=1263017&campaign=Skate+Attack&clickref=aeed784e-eef1-4517-8d88-b52cdb9d4676&clickref2=99a2e5f0-799b-40fc-a8d4-0f9d117f4552&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.skateattack.co.uk%2Fshop%2Fhockey.html&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/nGpS20Nf","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=53473218&linkaffid=35243533&ued=https%3A%2F%2Fwww.skateattack.co.uk%2Fshop%2Fhockey.html","sub_id":null,"hits":6,"unique_visitor":4,"landing_url":"https:\/\/www.skateattack.co.uk\/shop\/hockey.html","advertiser":{"id":"aed1b237-dbbf-4ad1-b932-9af7f37b4b13","user_id":null,"network_source_id":null,"advertiser_id":22855,"api_advertiser_id":"aed1b237-dbbf-4ad1-b932-9af7f37b4b13","sid":53473218,"name":"Skate Attack","currency_code":"GBP","average_payment_time":"53","validation_days":"29","epc":"0.23","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/skateattack.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/22855.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"5","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["United Kingdom"],"categories":["5f6b99cc-a5a4-41d9-a095-520eea4d6bb0","d60fc07d-ce1c-408c-888b-59114d593ba0"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450",