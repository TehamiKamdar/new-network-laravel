[2025-11-22 06:26:26] production.INFO: {"id":"0d0bd896-d895-4e05-95a4-84cb8f62f616","publisher_id":"aeed784e-eef1-4517-8d88-b52cdb9d4676","website_id":"99a2e5f0-799b-40fc-a8d4-0f9d117f4552","advertiser_id":"970d2e3f-2407-484b-a01f-501c46b4e49b","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=7899&id=1263017&campaign=The+Body+Shop+UK&clickref=aeed784e-eef1-4517-8d88-b52cdb9d4676&clickref2=99a2e5f0-799b-40fc-a8d4-0f9d117f4552&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.thebodyshop.com%2Fen-gb%2Fbody%2Fview-all-body%2Fc%2Fc00236&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/3nirlp01","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=88783204&linkaffid=35243533&ued=https%3A%2F%2Fwww.thebodyshop.com%2Fen-gb%2Fbody%2Fview-all-body%2Fc%2Fc00236","sub_id":null,"hits":74,"unique_visitor":24,"landing_url":"https:\/\/www.thebodyshop.com\/en-gb\/body\/view-all-body\/c\/c00236","advertiser":{"id":"970d2e3f-2407-484b-a01f-501c46b4e49b","user_id":null,"network_source_id":null,"advertiser_id":7899,"api_advertiser_id":"970d2e3f-2407-484b-a01f-501c46b4e49b","sid":88783204,"name":"The Body Shop UK","currency_code":"GBP","average_payment_time":"177","validation_days":"23","epc":"0.13","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/thebodyshopuk.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/7899.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"20","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["United Kingdom"],"categories":["d605708e-6585-4b1a-8f7a-cbf3cc57b81e"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["*.thebodyshop.com","thebodyshop.com"],"short_description":"Founded in 1976 in Brighton, England, by Anita Roddick, The Body Shop\u00ae is a global beauty brand built on making people feel good- face, body and soul. The Body Shop\u00ae has more than 3,000 stores in more than 60 countries.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">The Body Shop UK Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Welcome to The Body Shop Affiliate Program<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Our story started in Brighton, England in 1976. There our founder Dame Anita Roddick began mixing her own products and infusing them with a new idea: that business could be a force for good. Following her vision, for 40 years we\u2019ve been rule breaking, never faking and change making. We now have over 3,000 stores in 66 countries and employ over 22,000 people who help us bring our unique blend of ethical beauty with a sense of humour and serious purpose to the world.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Never afraid to stand out from the crowd and stand up for what\u2019s right, we search the world for the finest ethically-sourced ingredients to create a range of naturally inspired beauty products.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Today our dedication to using business as a force for good is stronger than ever. As part of our Enrich Not Exploit\u2122 Commitment, we\u2019ve made it our mission to enrich our products, our people, and our planet. That means working fairly with our farmers and suppliers and helping communities thrive through our Community Trade programme, being 100% vegetarian and always and forever being firmly against animal testing.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">In September 2017, we joined forces with Aesop and Natura to form Natura &amp;Co, the union of three beauty companies with a shared commitment to ethical and sustainable cosmetics.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Together we can do it, it\u2019s in our hands.<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>We look forward to working with you!<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>The Body Shop Programme Commission<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Earn up to 8% commission for all sales from existing Body Shop customers and new customers. A new Body Shop customer is classified as someone who has never bought with The Body Shop before.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">An additional exclusive commission is also available to Affiliates (Please note that VAT and Commission is not included in the commission payment)<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Publishers will receive 1% commission for all bulk order sales<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Cookie Length<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">30 Days<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Benefits of The Body Shop Affiliate Program<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Weekly promotions<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Press releases<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Trackable Deep links<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Monthly Discount Codes<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Video Content<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">HTML Newsletters &amp; Non-coded newsletters<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Static Text Links<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Product Feed<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Email Blasts<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>New Ecommerce Website: https:\/\/www.thebodyshop.com\/en-gb\/<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Responsive platform \u2013 The website responds to the device it\u2019s viewed on so customers get a consistent experience<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Online chat \u2013 Specialists in skincare, gifting and any other queries are available to message with any questions or concerns a customer may have<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Personalised Skincare \u2013 a Diagnostic tool to help guide a customer to their most suited skincare products<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Beauty advice \u2013 from body care tips to make-up looks, there are guides and videos to help<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Gifting hub to help customers find a suitable gift<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>LYBC Customer Loyalty Club Benefits<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Rewards: The more customers shop, the more they earn. Get 10 points for every \u00a31 spent. Then when 500 points are earnt customers get a \u00a35 reward<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Events: Customers get invited to exclusive members-only events and sneak previews of The Body Shop new collections.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Treats: Who doesn\u2019t like a present? We\u2019ll give customers a \u00a35 reward as a birthday treat<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Brand Compliance Rules<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1. A registered trademark symbol \u00ae must be clearly used at all times next to The Body Shop\u00ae, brand. A capital letter is also required on The Body Shop at all times.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">For Example: The Body Shop\u00ae products\/stores etc\u2026 rather than, the body shop products\/stores, etc\u2026<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2. Corporate use of the name (i.e., reference to the \"The Body Shop\" group of companies or any company thereof) should be without the \"\u00ae\". For example: The Body Shop is an ethical company.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3. All use of The Body Shop\u00ae visual logos will require that a registered trademark \u00ae symbol is used against them.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4. Any brand copy should refer to the brand correctly as:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">The Body Shop\u00ae and NOT Body Shop. Plus: The brand name should not appear over two lines.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5. A selection of The Body Shop\u00ae products should have the registered trademark \u00ae symbol or the trademark TM symbol next to them. These are below:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>White Musk\u00ae<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Spa Wisdom \u2122<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Oceanus \u2122<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Moisture White \u2122<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;Wise Woman \u2122<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">6. In addition; a selection of The Body Shop\u00ae generic terms should have the trademark \u2122 symbol next to them. These are below:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>The Body Shop At Home \u2122<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Love Your Body \u2122<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">7. The Body Shop\u00ae will only work with websites that are neutral on political views or express views in line with The Body Shop values.&nbsp; The following websites will be rejected if they do not meet the following criteria:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u2022 Websites must be intended for a U.K. audience<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u2022 Websites must be active\/live during the application process<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u2022 Websites must be visually pleasing<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u2022 No adult pornography websites<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u2022 No religious websites<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u2022 No brand websites who have had a history of supporting sweatshops, (e.g. Nike or The Gap)<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u2022 No websites that accept tobacco company advertising<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">\u2022 No websites that feature excessive pop-ups or pop-unders<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">8. Voucher codes for The Body Shop\u00ae must only be used with authorisation from The Body Shop\u00ae. Anybody caught using a voucher code taken from another site will be asked to remove it immediately and may face commission sanctions with non-compliance.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">9. The Body Shop will not pay any commission on Ginger Shampoo products due to fraudulent resell issuses.&nbsp;<\/p><\/div>","program_policies":"<p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">This is the Agreement that will govern your participation in an Engagement through the &nbsp;Awin UK Network with Us.&nbsp; Please read this Agreement and check the box on the previous page to digitally sign this Agreement.&nbsp;&nbsp;To print a copy of this Agreement, please use your browser's print command.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>PUBLISHER AGREEMENT<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">This Publisher Agreement (this \"<span style=\"margin: 0px; padding: 0px;\">Agreement<\/span>\") is made between you (\"<span style=\"margin: 0px; padding: 0px;\">You<\/span>\" or \u201c<span style=\"margin: 0px; padding: 0px;\">Your<\/span>\u201d) and The Body Shop International PLC (\"<span style=\"margin: 0px; padding: 0px;\">We<\/span>\" or \"<span style=\"margin: 0px; padding: 0px;\">Us<\/span>\" or \u201c<span style=\"margin: 0px; padding: 0px;\">Our<\/span>\u201d). Neither &nbsp;Awin Limited nor any of its affiliates are parties to this particular Agreement, You have your own agreement directly with &nbsp;Awin Limited (\u201c<span style=\"margin: 0px; padding: 0px;\">&nbsp;AWIN<\/span>\u201d).<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>BACKGROUND<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Both parties desire to establish the general terms and conditions which shall govern advertising and commission arrangements between them resulting from our participation in the &nbsp;AWIN UK Network. We are engaging You to promote our products via your online presence and to attract visitors to Our Site (a \u201c<span style=\"margin: 0px; padding: 0px;\">Customer<\/span>\u201d) to purchase products.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>TERMS AND CONDITIONS<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">In consideration of the promises set forth below, each party agrees as follows<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1. Offers and Engagements.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.1. From time to time, We may post on the Awin UK Network interface (the \u201c<span style=\"margin: 0px; padding: 0px;\">Interface<\/span>\u201d) offers (each, an \"<span style=\"margin: 0px; padding: 0px;\">Offer<\/span>\") to pay to participants a specified commission in return for certain advertising services leading to a Qualifying Link (defined below).&nbsp;&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.2. If You accept one of our Offers or post a Qualifying Link, we will have entered into an \"<span style=\"margin: 0px; padding: 0px;\">Engagement<\/span>.\"&nbsp; Each Engagement shall be governed by the terms and conditions of this Agreement (and where possible shall have the same identification number as the original Offer). Each Offer is governed by the terms of the Engagement which shall be specific to that Offer and in no way alter the terms and conditions of this Agreement.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.3. At any time prior to You displaying a Qualifying Link on one of Your websites, We may, with or without notice (a) change, suspend or discontinue any aspect of an Offer or an Engagement or (b) remove, alter, or modify any graphic or banner ad that we have submitted for an Offer or an Engagement.&nbsp; You agree to promptly implement any request from Us to remove, alter or modify any such graphic or banner ad.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>2. Your Responsibilities.<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.1. You hereby agree to comply with all applicable laws, the UK Code of Non-broadcast Advertising, Sales Promotion and Direct Marketing (the \u201c<span style=\"margin: 0px; padding: 0px;\">CAP Code<\/span>\u201d); including guidance and advice from the Committee of Advertising Practice and the Broadcast Committee of Advertising Practice and adjudications by the Advertising Standards Authority (the \u201c<span style=\"margin: 0px; padding: 0px;\">ASA<\/span>\u201d) as updated from time to time.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.2 You hereby agree that the position, prominence and nature of links on the Your site shall comply with any requirements specified in the Engagement, but otherwise will be in Your discretion.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.2. You agree not to make any representations, warranties or other statements concerning Us, Our site, any of Our products or services, or Our site policies that are not in accordance with these terms and conditions, with the information provided by us including the CAP Code regulations, unless expressly authorised by the Engagement.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.3. You can find URLs to be used for your Engagement on the Interface in the Overview section or you can take the URLs from Our website (the \"<span style=\"margin: 0px; padding: 0px;\">Required URLs<\/span>\"). You are to add your tracking details to the Required URLs accordingly to link Your site to Our Site (details on how to do this can be found the Interface in the Links and Tools section) \"<span style=\"margin: 0px; padding: 0px;\">Qualifying Link<\/span>\"). Your payment is based on a Customer hitting Our site thru Your Qualifying link and finalising the sale of products. There is a 30 day window of time in which a Customer can purchase products in which You receive commission based on your Qualifying link.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.4&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; You are responsible for notifying Us (by using the email found in the Overview section of the Interface &nbsp;and &nbsp;AWIN of any incorrect, dead or misdirected Required URLs specified in the Engagement or other problems with Your participation in the Engagement.&nbsp; We will respond promptly to all concerns upon receipt of Your notification.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>3. Commissions.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.1. We agree to pay to You the commission specified in the \u2018Commissions\u2019 section of the Interface if We sell to Customer any product via Your Qualifying Link.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.3. We shall have the sole right and responsibility for processing all orders made by Customers. You acknowledge that all agreements relating to sales to Customers shall be between Us and the Customer. With the exception of any cashback sites, You are to submit the cash back to the Customer yourself and We do not have any part in this transaction<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.4. All determinations of Qualifying Links and whether a commission is payable will be made by &nbsp;AWIN and will be final and binding on both You and Us, as per the terms and conditions of Your agreement with &nbsp;AWIN.&nbsp; Prices for the products will be set solely Us in Our sole discretion.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>4. Ownership and Licenses.<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4.1. Each party owns and shall retain all right, title and interest in its names, logos, trademarks, service marks, trade dress, copyrights and proprietary technology, including, without limitation, those names, logos, trademarks, service marks, trade dress, copyrights and proprietary technology currently used or which may be developed and\/or used by it in the future.<\/p><p style=\"margin-right: 0px; mar