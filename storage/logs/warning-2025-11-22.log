[2025-11-22 18:42:19] production.INFO: {"id":"79a6ef5a-0c36-4ec2-90f1-80fa08d5114a","publisher_id":"2cb22ca9-2da4-4e79-b499-e6f042a55fae","website_id":"78471f46-3aea-4178-98be-23952feb2804","advertiser_id":"87bfa878-ac28-419e-93c4-b307b34dbb91","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=22394&awinaffid=1263017&campaign=Assembly+Coffee&clickref=2cb22ca9-2da4-4e79-b499-e6f042a55fae&clickref2=78471f46-3aea-4178-98be-23952feb2804&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fassemblycoffee.co.uk%2Fpages%2Foffice-subscriptions&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/A7CtjHZX","tracking_url_long":null,"sub_id":null,"hits":2,"unique_visitor":2,"advertiser":{"id":"87bfa878-ac28-419e-93c4-b307b34dbb91","user_id":null,"network_source_id":null,"advertiser_id":22394,"api_advertiser_id":"87bfa878-ac28-419e-93c4-b307b34dbb91","sid":82420342,"name":"Assembly Coffee","currency_code":"GBP","average_payment_time":"36","validation_days":"4","epc":"0.29","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/assemblycoffee.png","fetch_logo_url":null,"is_fetchable_logo":0,"fetch_logo_error":null,"status":0,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"15","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":0,"country_full_name":["United Kingdom"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["assemblycoffee.co.uk"],"short_description":"Assembly Coffee is a London-based, independent coffee roastery that drives and promotes innovation throughout the specialty coffee supply chain.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Assembly Coffee Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We are a London-based, independent coffee roastery that drives and promotes innovation throughout the specialty coffee supply chain. We strive to set the leading example for the industry, in roasted coffees that are the pinnacle of quality, innovation in how quality is communicated and redefinition of how coffee can be sourced to return greater value to farming communities.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b><span style=\"margin: 0px; padding: 0px;\">Coffee<\/span>:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Our most fundamental belief is in the potential of the specialty coffee model to redistribute opportunity based on merit rather than circumstance. That is that opportunity should be awarded equally.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We only source coffees that we believe to be exceptional in quality. Our range covers both espressos and filter coffee and includes coffees which exhibit clean and classic characteristics of coffee quality as well as more contemporary, exotic profiles which showcase farming innovation<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We only promote coffees when we are certain that our trade and investments support sustainable outcomes.The coffees in our catalogue are purchased without intermediaries, with 100% transparency and at an average price of 215% above Fairtrade.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Environment<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We\u2019re a Certified Carbon Neutral coffee roastery. This measures, reduces and offsets emissions at the most granular level and at every stage of our supply chain. In addition we use 100% renewable energy sources and roast on Loring smart roasters producing 80% less emissions than other commercial coffee roasters.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Story<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">The Roastery began in 2014 when likeminded London coffee professionals assembled to share experiences and ideas on how every element of a coffee roastery could be improved to promote shared industry goals. In this group were co-founders of Assembly, Michael Cleland and Nick Mabey, as well as owner operators from some of the most progressive coffee businesses in the UK.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Six months of planning and feedback later Assembly emerged with packaging, design, insight reports and a coffee catalogue that were directly informed by the group. In April 2015 Assembly officially opened as a roastery, sponsoring the inaugural Coffee Masters Competition at London Coffee Festival, and being served at cafes across the UK&nbsp;<\/p><\/div>","program_policies":"<p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We look forward to working together, please remember that when applying for affiliate status for the Assembly Coffee&nbsp;programme you are agreeing to the terms and conditions as stated below.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Terms<\/span><br style=\"margin: 0px; padding: 0px;\"><b>Your website is:<\/b><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Compatible with Assembly Coffee brand, its identity and values and our product types<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Honest, factually correct, and clear in promotional content&nbsp;and intent.<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Paid Search Policy<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates may generate extra commission by using Pay per Click (PPC) advertising programs, i.e. Google Adwords, Bing. However,&nbsp;please adhere to the following guidelines:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates are not permitted to use or bid on any Assembly Coffee brand terms including misspellings or other variations on all search engines, directories or any other online database, except where permission has been granted.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates are not permitted to bid on brand\/product&nbsp;terms + generic terms, e.g. Assembly coffee beans. No affiliate is allowed to bid on brand terms + generics without expressed written consent from Assembly Coffee.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">To ensure you do not appear on these terms, you are required to assign a negative broad match to all Assembly brand terms<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates may not link their PPC adverts directly to assemblycoffee.co.uk or any sub-domain of assemblycoffee.co.uk<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates may not buy, own or bid on any domain names with the word \u2018assembly&nbsp;coffee\u2019 in the URL<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Discount \/ Promotional \/ Voucher&nbsp;Codes &amp; Offers<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">All discount \/ promotional \/ voucher codes, offers and incentives must be authorised through the Assembly Coffee affiliate program.&nbsp;&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates found to be using unauthorised voucher codes face immediate suspension from the programme. We reserve the right to withhold payment if non-authorised voucher codes are used in an affiliate sale.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Creative<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Affiliates may not alter any of the creative or text links available through the AWIN interface.<\/p>","url":"https:\/\/assemblycoffee.co.uk\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=22394&id=1263017","type":"api","created_at":"2023-03-21T07:05:38.000000Z","updated_at":"2025-04-30T09:46:08.000000Z","deleted_at":null,"is_show":0,"is_request__process":0,"is_active":0,"custom_domain":"assemblycoffee.co.uk"}}  
