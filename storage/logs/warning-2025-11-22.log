[2025-11-22 08:30:56] production.INFO: {"id":"020b9a5d-84c0-4e5c-8406-bd2f4871a08e","publisher_id":"ebbf62c5-ae46-4b24-8b40-2c15d8143c97","website_id":"3fb8982d-b3c5-48b2-b7a0-21073be3d08e","advertiser_id":"3a04ec5c-041b-4896-9f0e-2268d3477179","click_through_url":"https:\/\/www.awin1.com\/cread.php?awinmid=11469&awinaffid=1263017&campaign=Boxerman+DE&clickref=ebbf62c5-ae46-4b24-8b40-2c15d8143c97&clickref2=3fb8982d-b3c5-48b2-b7a0-21073be3d08e&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fboxerman.de%2Fstyles%2Fslips%2F&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/RONzWSAO","tracking_url_long":null,"sub_id":null,"hits":17,"unique_visitor":14,"advertiser":{"id":"3a04ec5c-041b-4896-9f0e-2268d3477179","user_id":null,"network_source_id":null,"advertiser_id":11469,"api_advertiser_id":"3a04ec5c-041b-4896-9f0e-2268d3477179","sid":79511464,"name":"Boxerman DE","currency_code":"EUR","average_payment_time":"82","validation_days":"53","epc":"0.14","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/boxermande.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/11469.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"8","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["Germany"],"categories":["9d3f8472-6dba-4d31-be93-459b31a76d84"],"primary_regions":["DE"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["*.boxerman.de","boxerman.de"],"short_description":"Boxerman ist der neue Herren Unterw\u00e4sche Shop und pr\u00e4sentiert Mann alles, was er f\u00fcr darunter braucht in einem Onlineshop. Mit Boxershorts, Briefs, Unterhemden und Mehr von beliebten Marken wie Calvin Klein, Tommy Hilfiger, Schiesser oder Lacoste.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Boxerman DE Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" bis_skin_checked=\"1\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Programmbedingungen Boxerman Partnerprogramm<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Nehmen Sie an unserem Partnerprogramm teil und profitieren Sie von unseren starken Marken und dynamischen Provisionsmodell von bis zu 10%. Durch unsere besonders hohen Conversion Rates profitieren Sie schnell.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Boxerman will Mann das l\u00e4stige Unterw\u00e4sche Shopping abnehmen und pr\u00e4sentiert Mann alles, was er f\u00fcr darunter braucht in einem Onlineshop. Mit beliebten Marken wie Calvin Klein, Tommy Hilfiger, Lacoste, Schiesser, Jockey, Gant, Lacoste oder D.E.A.L International&nbsp;ist f\u00fcr jeden Geschmack etwas dabei. Ab einem Bestellwert von 39 \u20ac kommt die Bestellung versandkostenfrei bei unseren Kunden an.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Vorteile f\u00fcr unsere Kunden:<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Ein breites Sortiment an Herrenunterw\u00e4sche der h\u00f6chsten Qualit\u00e4t von starken Marken wie Schiesser, Calvin Klein, Tommy Hilfiger, Gant, Jack &amp; Jones und vielen mehr!<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Kostenloser Versand aller Bestellungen ab 39 \u20ac Warenwert<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Bei Bestellung bis 16 Uhr wird die Bestellung noch am gleichen Tag versandt und ist so besonders schnell bei unseren Kunden Zuhause<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Kostenlose R\u00fccksendung aller Bestellungen<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Vorteile f\u00fcr SIE?<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Hohe Umsatzrate und etablierte Marken mit hohem Bekanntheitsgrad<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Durchschnittlicher Bestellwert von 63&nbsp;\u20ac<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Hochwertige und klickstarke Werbemittel, gerne erstellen wir auf Anfrage weitere Werbemittel<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Hohe Conversion Rate<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Regelm\u00e4\u00dfige verkaufsf\u00f6rdernde Ma\u00dfnahmen<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Regelm\u00e4\u00dfige Rabattaktionen und Gutscheine. Auf Anfrage gerne auch exklusive Gutscheine<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Attraktive Verg\u00fctung<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Pers\u00f6nlicher Ansprechpartner<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Verdienen Sie bis zu 10% des gesamten Bestellwertes!<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Als Gesch\u00e4ftspartner bieten wir Ihnen die folgende Provision:<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1- 20 Verk\u00e4ufe\/Monat: 8 % Provision<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">21- 40&nbsp;Verk\u00e4ufe\/Monat: 9 %&nbsp;Provision<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">40 Verk\u00e4ufe\/Monat: 10 %&nbsp;Provision<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Kontakt<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Bei Fragen, Anmerkungen oder W\u00fcnschen nehmen Sie jederzeit Kontakt mit mir auf: werneke@boxerman.de<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Nehmen Sie auch Kontakt mit uns auf, wenn Sie Ideen haben, wie Ihre Internetseite einen h\u00f6heren Umsatz generieren kann oder wenn Sie beispielsweise einen Newsletter an eine gr\u00f6\u00dfere Zielgruppe planen \u2013 in diesen F\u00e4llen k\u00f6nnen wir nach Absprache ein individuelles Provisionsniveau vereinbaren.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Wir freuen uns auf eine erfolgreiche Zusammenarbeit!<\/span><\/p><\/div>","program_policies":"<p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Mit der Bewerbung beim Boxerman Partnerprogramm versichert der Affiliate die folgenden Bedingungen zu beachten. Verst\u00f6\u00dfe gegen diese Bedingungen f\u00fchren zum sofortigen Ausschluss des Partnerprogramms und Stornierung der regelwidrig generierten Sales.<\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Nur akzeptierte Partnerprogramme d\u00fcrfen Gutscheine bewerben werden, die im Partnerprogramm kommuniziert werden (via Newsletter oder Incentive)<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Es d\u00fcrfen keine abgelaufenen Gutscheine beworben werden.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Alle abgelaufenen Gutscheine m\u00fcssen bitte entfernt werden.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Die Boxerman Website darf nicht direkt in einem PopUp, PopUnder, Frame, iFrame oder Layer aufgerufen werden.<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Cashback und Loyalty Publisher nur nach Absprache<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Co-registrierungen \/ Co-Sponsoring nicht erlaubt<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Forced Clicks und Paidmail sind nicht erlaubt<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Nicht erlaubt sind Websites mit Pornographie, Gewaltdarstellungen (Sexuelle Gewalt, T\u00f6tung von Menschen oder Tieren), diskriminierenden Darstellungen von Personen, Beleidigungen, extremistischen, radikalpolitischen oder jugendgef\u00e4hrdenden Inhalten, Verharmlosungen oder Verherrlichung von Drogen und Waffen und einem nicht angebrachten Sprachgebrauch (sexualisierte Sprache, derber Sprachgebrauch, Gottesl\u00e4sterung, etc.), Verlinkungen zu anderen Websites mit solchen Inhalten, Video-on-Demand-Websites (Kinox.to, movie2k, o.\u00e4) und Torrent-Sites (torrent.to).<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Ihr wollt einen Newsletter f\u00fcr Boxerman versenden? Bitte wendet Euch hierzu an unser Publisherteam. Auch f\u00fcr exklusive Gutscheine k\u00f6nnt Ihr uns gerne direkt ansprechen.<\/p><div bis_skin_checked=\"1\"><br><\/div>","url":"https:\/\/boxerman.de\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=11469&id=1263017","type":"api","created_at":"2023-03-21T07:05:14.000000Z","updated_at":"2025-04-18T10:56:41.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":1,"custom_domain":"boxerman.de"}}  
