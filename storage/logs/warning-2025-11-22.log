[2025-11-22 06:34:25] production.INFO: {"id":"fdbb56b2-33ee-43a1-85c3-680301094aad","publisher_id":"aeed784e-eef1-4517-8d88-b52cdb9d4676","website_id":"99a2e5f0-799b-40fc-a8d4-0f9d117f4552","advertiser_id":"aed1b237-dbbf-4ad1-b932-9af7f37b4b13","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=22855&id=1263017&campaign=Skate+Attack&clickref=aeed784e-eef1-4517-8d88-b52cdb9d4676&clickref2=99a2e5f0-799b-40fc-a8d4-0f9d117f4552&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.skateattack.co.uk%2Fshop%2Ffigure-skating.html&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/Qo1k1g1J","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=53473218&linkaffid=35243533&ued=https%3A%2F%2Fwww.skateattack.co.uk%2Fshop%2Ffigure-skating.html","sub_id":null,"hits":26,"unique_visitor":13,"landing_url":"https:\/\/www.skateattack.co.uk\/shop\/figure-skating.html","advertiser":{"id":"aed1b237-dbbf-4ad1-b932-9af7f37b4b13","user_id":null,"network_source_id":null,"advertiser_id":22855,"api_advertiser_id":"aed1b237-dbbf-4ad1-b932-9af7f37b4b13","sid":53473218,"name":"Skate Attack","currency_code":"GBP","average_payment_time":"53","validation_days":"29","epc":"0.23","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/skateattack.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/22855.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"5","commission_type":"%","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["United Kingdom"],"categories":["5f6b99cc-a5a4-41d9-a095-520eea4d6bb0","d60fc07d-ce1c-408c-888b-59114d593ba0"],"primary_regions":["GB"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["*.skateattack.co.uk","skateattack.co.uk"],"short_description":"Skateattack.co.uk is one of the UK\u2019s favourite destinations for roller skates and skating products, both on and off the ice. We\u2019re the one stop shop for the most popular skateboards, scooters, skating and roller derby products in the UK.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\">Skate Attack Affiliate Program<\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Skateattack.co.uk is one of the UK\u2019s favourite destinations for roller skates and skating products, both on and off the ice. We\u2019re the one stop shop for the most popular skateboards, scooters, skating and roller derby products in the UK, plus clothing and protective gear. Established in 1979, Skate Attack is a trusted retailer. We also specialise in custom skates.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">We have a great selection of top branded products available &amp; sizes ranging from children to adults. We stock most leading brands including MPG, Graf, Edea, Risports, Bauer, Heelys, SFR, Rio Roller, Rookie Rollerskates, Riedell and many more. All at incredible prices.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>SkateAttack Affiliate Programme<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">About Skate Attack (UK) Ltd&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Launched in 1979, skateattack.co.uk&nbsp; has become one of the UK\u2019s favourite destinations for roller skates and skating products, both on and off the ice. We\u2019re the one stop shop for the most popular skateboards, scooters, skating and roller derby products in the UK, plus clothing and protective gear. Skate Attack is a trusted retailer who also specialise in custom skates.&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Skate Attack is a fun and friendly company to work with, and view affiliates as a valuable part of the Skate Attack Marketing Team. Our Affiliate Programme offers some of the highest commission rates in the sports goods sector.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Why choose Skate Attack?<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">Competitive commission rate<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">High sales conversions<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">High approval rates<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">60 day cookie period<\/li><li style=\"margin: 0px; padding: 0px; list-style: none;\">Regularly updated data feeds<\/li><\/ul><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Commission Structure:<\/b><\/span><\/p><ul style=\"margin-bottom: 10px;\"><li style=\"margin: 0px; padding: 0px; list-style: none;\">7%<\/li><\/ul><\/div>","program_policies":"<div class=\"col-lg-12\" style=\"margin: 0px; padding: 0px 20px; min-height: 1px;\"><div id=\"termsFreeTextContentView\" class=\"inlineTextArea \" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><b>Skate Attack - PPC Policy<\/b><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">We allow our affiliates to promote Skate Attack via PPC, however there are some restrictions in place which should be adhered to.<br style=\"margin: 0px; padding: 0px;\">We do not allow affiliates to run Google Shopping ads on our product range.<br style=\"margin: 0px; padding: 0px;\">We request that affiliates do not bid on our brand name, URL or any misspellings or derivatives of our brand name or URL. Including, but not limited to the following keywords:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\"><b>skate attack<br style=\"margin: 0px; padding: 0px;\"><\/b>skateattack<br style=\"margin: 0px; padding: 0px;\">skateattack.com<br style=\"margin: 0px; padding: 0px;\">skateattack.co.uk<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Affiliates should add the terms mentioned above as negative broad match keywords.<br style=\"margin: 0px; padding: 0px;\">We also restrict PPC terms in the format of brand name + hybrid term e.g. \u201cSkateattack Roller Skates\u201d would be restricted, however an affiliate could bid on the generic term \u201cRoller Skates\u201d.<br style=\"margin: 0px; padding: 0px;\">We do not allow affiliates to link directly to us from search engines.<br style=\"margin: 0px; padding: 0px;\">We allow affiliates to use our display URL (www.skateattack.co.uk) for generic terms only.<br style=\"margin: 0px; padding: 0px;\">We also allow naming our brand in the title and description lines in their ads for generic terms.<br style=\"margin: 0px; padding: 0px;\">Skate Attack requests that affiliates refrain from bidding on competitor\u2019s brand terms.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><br style=\"margin: 0px; padding: 0px;\">Skate Attack will be monitoring brand name abuse and will be in contact with affiliates found to be breaching the terms outlined in the policy above. This policy applies to all search engines and PPC platforms. This is monitored through third party software on a 24\/7 basis. Any affiliate found to be breaching these restrictions may face suspension from the program with loss of commission.<br style=\"margin: 0px; padding: 0px;\">&nbsp;<br style=\"margin: 0px; padding: 0px;\"><b>Voucher Code Policy<br style=\"margin: 0px; padding: 0px;\"><\/b>We may distribute certain voucher codes exclusively to affiliates and other 3rd party marketing partners. Under no circumstances can these voucher codes be used, distributed or promoted by any party other than the affiliate\/marketing partner to whom the voucher code was granted to. If a voucher code is used by an affiliate\/marketing partner without authorisation, we reserve the right to not validate any commissions attributed to the unauthorised usage of said voucher code.<br style=\"margin: 0px; padding: 0px;\">Voucher codes cannot currently be used on any sale items.<br style=\"margin: 0px; padding: 0px;\">&nbsp;<br style=\"margin: 0px; padding: 0px;\">If clarification is required on any of the policies\/restrictions above or for any other queries, please get in touch at: sales@skateattack.co.uk\/<\/p><\/div><\/div>","url":"https:\/\/www.skateattack.co.uk\/","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=22855&id=1263017","type":"api","created_at":"2023-03-21T07:05:39.000000Z","updated_at":"2025-04-18T11:05:51.000000Z","deleted_at":null,"is_show":1,"is_request__process":0,"is_active":1,"custom_domain":"skateattack.co.uk"}}  
