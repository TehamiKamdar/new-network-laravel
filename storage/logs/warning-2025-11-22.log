[2025-11-22 06:23:50] production.INFO: {"id":"c36b2c3b-28d4-425e-bbca-5bb5ff15957e","publisher_id":"aeed784e-eef1-4517-8d88-b52cdb9d4676","website_id":"99a2e5f0-799b-40fc-a8d4-0f9d117f4552","advertiser_id":"de4b7eb1-2943-4283-a8fe-40f7ce8bfd9b","click_through_url":"https:\/\/www.awin1.com\/awclick.php?mid=29037&id=1263017&campaign=STA+Travel+DE&clickref=aeed784e-eef1-4517-8d88-b52cdb9d4676&clickref2=99a2e5f0-799b-40fc-a8d4-0f9d117f4552&clickref3=&clickref4=&clickref5=&clickref6=&ued=https%3A%2F%2Fwww.statravel.de%2Freise-deals%2F&platform=pl","tracking_url":"https:\/\/go.linkscircle.com\/deeplink\/9f8XICMn","tracking_url_long":"https:\/\/go.linkscircle.com\/deeplink?linkmid=18667156&linkaffid=35243533&ued=https%3A%2F%2Fwww.statravel.de%2Freise-deals%2F","sub_id":null,"hits":88,"unique_visitor":41,"landing_url":"https:\/\/www.statravel.de\/reise-deals\/","advertiser":{"id":"de4b7eb1-2943-4283-a8fe-40f7ce8bfd9b","user_id":null,"network_source_id":null,"advertiser_id":29037,"api_advertiser_id":"de4b7eb1-2943-4283-a8fe-40f7ce8bfd9b","sid":18667156,"name":"STA Travel DE","currency_code":"EUR","average_payment_time":"54","validation_days":"25","epc":"0.24","tags":null,"offer_type":null,"source":"Awin","logo":"storage\/statravelde.png","fetch_logo_url":"https:\/\/ui.awin.com\/images\/upload\/merchant\/profile\/29037.png","is_fetchable_logo":1,"fetch_logo_error":null,"status":1,"provider_status":null,"company_name":null,"phone_number":null,"address":null,"city":null,"state":null,"country":null,"commission":"5","commission_type":"EUR","goto_cookie_lifetime":null,"deeplink_enabled":1,"exclusive":0,"is_available":1,"country_full_name":["Germany"],"categories":["4c1e7c4d-c90b-46b3-ab29-528a2c090a95","7b67df5e-55f2-441e-95c6-e55dcb54d33e"],"primary_regions":["DE"],"supported_regions":null,"program_restrictions":["1dec570f-8ec0-480e-bc57-9ba07f9f8b31","ed13f0b6-6916-4e3f-8288-8dcbc84611e2"],"promotional_methods":["5f2ce3f8-a7c5-4939-ab0e-9855a2713450","8ae99f6d-d390-420c-b738-5699955ba938","c61eae9e-56c1-4024-855f-a457d692a42f","d27add63-b8f5-471d-be5a-a3613957b8d4","f310a994-5efb-4ab2-9e21-323cc45d9813"],"valid_domains":["statravel.de","*.statravel.de"],"short_description":"STA Travel ist der Spezialist f\u00fcr Jugend- und Studentenreisen. Bei uns bekommst du alles f\u00fcr eine unvergessliche Reise, von Around the World Tickets, exklusiven Flugtarifen, \u00fcber spannende Rundreisen, Work & Travel Pakete und Freiwilligenprojekte.","description":"<h4 style=\"margin-right: 0px; margin-bottom: 0.5em; margin-left: 0px; padding: 0px; line-height: 1.25; margin-top: 15px !important;\"><span style=\"vertical-align: inherit;\">STA Travel UK Affiliate Program<\/span><\/h4><div id=\"descriptionLongContentView\" class=\"inlineTextArea ck-editable-icon\" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"vertical-align: inherit;\">STA Travel - We believe that travel helps to discover the world in all its diversity and to broaden one's own horizons.&nbsp;Out of this enthusiasm, the STA Travel brand was launched in 1979 by two young students in Australia.&nbsp;Their mission: to make cheap flights and affordable adventure travel accessible to other students, young people and world explorers.&nbsp;That was over 40 years ago.&nbsp;Even today we love nothing more than learning a new language, culture or environment and exploring the world.&nbsp;Travel is our passion, and we use that passion and experience to create your very own, life-changing travel experience.<\/span><br style=\"margin: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px; vertical-align: inherit;\">&nbsp;#TravelForWorldDiscoverers<\/span><\/p><\/div>","program_policies":"<div id=\"container\" class=\"container-fluid\" style=\"margin-top: 0px; margin-bottom: -40px; padding: 0px; min-height: 100%; height: auto !important;\"><section id=\"content\" style=\"margin: 20px; padding: 0px; clear: both;\"><div class=\"row row-widget\" style=\"margin: 0px -10px; padding: 0px;\"><div class=\"col-md-9 col-lg-9 wrapper-widget\" style=\"margin: 0px; padding: 0px 10px; min-height: 1px; float: left; width: 836.25px;\"><div class=\"profileTabContent widget padding-LR-null\" id=\"profileTabContent\" style=\"margin: 0px 0px 20px; padding: 0px 0px 25px; border: 1px solid rgb(222, 222, 222); display: inline-block; border-radius: 2px; width: 816.25px; position: relative;\"><div class=\"col-lg-12\" style=\"margin: 0px; padding: 0px 20px; min-height: 1px;\"><div id=\"termsTabContent\" style=\"margin: 0px; padding: 0px;\"><div class=\"col-lg-12\" style=\"margin: 0px; padding: 0px 20px; min-height: 1px;\"><div id=\"termsFreeTextContentView\" class=\"inlineTextArea \" style=\"margin: 10px 0px 0px; padding: 0px;\"><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\"><b>Teilnahmebedingungen Partnerprogramm STA Travel&nbsp; (Account: 29037)<\/b><\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Zus\u00e4tzlich zu den Allgemeinen Gesch\u00e4ftsbedingungen der AWIN GmbH f\u00fcr Publisher gelten f\u00fcr das Partnerprogramm von STA Travel die nachfolgend aufgef\u00fchrten Teilnahmebedingungen. Mit der Bewerbung f\u00fcr das STA Travel Partnerprogramm erkl\u00e4rt sich der Publisher mit den Teilnahmebedingungen ausdr\u00fccklich einverstanden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">1.Teilnahme am STA Travel Partnerprogramm<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.1 Der Publisher muss \u00fcber eine eigene Website mit einem einfach erreichbaren und vollst\u00e4ndigen Impressum (\u00a7 5 TMG) verf\u00fcgen. Die Website muss den jeweils aktuell g\u00fcltigen gesetzlichen Vorschriften, insbesondere zum Verbraucherschutz, gen\u00fcgen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.2 Die Website des Publishers darf nicht den Eindruck erwecken als w\u00fcrde sie von STA Travel verantwortet oder als k\u00f6nnte der Publisher STA Travel im Rechtsverkehr vertreten bzw. Erkl\u00e4rungen gegen\u00fcber Dritten f\u00fcr STA Travel abgeben und\/oder entgegennehmen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.3 Folgende Gesch\u00e4ftsmodelle und Werbeumfelder sind im STA Travel Partnerprogramm nicht zugelassen:<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">a. Websites mit Verwechslungsgefahr zur Website statravel.de<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b. Websites mit rechtswidrigen, diskriminierenden, gewaltverherrlichenden, politischen oder jugendgef\u00e4hrdenden Inhalten oder entsprechenden verlinkten Angeboten<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">c. Paidmailer, Forced Clicks, etc. d. Bannerfarmen<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">e. Geparkte Domains<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">f. Vertipper-Domains bzw. Domains mit STA Travel als Bestandteil<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">h. Seiten, welche Missbrauchsmethoden nutzen, insbesondere Cookie-Dropping, SEA Brandhijacking, Falsche Identit\u00e4ten, Fake Bestellungen, E-Mail Spam, Spyware\/Adware\/Malware&nbsp;<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">i. Ausgeschlossen ist auch das Betreiben von Software, die die Buchung au\u00dferhalb der Buchungsmaschine von STA Travel erm\u00f6glicht. Zus\u00e4tzliche Geb\u00fchren d\u00fcrfen nicht durch automatisierte Prozesse erhoben werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.4 STA Travel steht es frei, den Publisher zur Teilnahme zuzulassen oder abzulehnen. Ein Anspruch auf Zulassung besteht nicht. Durch die Zulassung entsteht keine Partnerschaft, kein Joint-Venture, keine Franchise- oder Handelsvertreterbeziehung, kein Angestelltenverh\u00e4ltnis oder eine sonstige Beziehung, die \u00fcber die Affiliate-Partnerschaft hinausgeht.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.5 Die Teilnahme des Publishers am Partnerprogramm von STA Travel kann von beiden Seiten jederzeit gek\u00fcndigt werden. Eine K\u00fcndigung der Teilnahme durch den Publisher ist jederzeit ohne Einhaltung einer Frist m\u00f6glich. Eine K\u00fcndigung der Teilnahme des Publishers durch STA Travel ist unter Einhaltung einer Frist von zwei Wochen m\u00f6glich und mindestens in Textform zu erkl\u00e4ren. Das Recht zur fristlosen K\u00fcndigung bei Vorliegen eines wichtigen Grundes bleibt unber\u00fchrt. Ein wichtiger Grund liegt f\u00fcr STA Travel insbesondere vor bei einem schwerwiegenden Versto\u00df des Publishers gegen diese Teilnahmebedingungen, wie z.B. Verst\u00f6\u00dfe gegen Ziff. 1.3, 2 und 3. Nach Beendigung der Teilnahme des Publishers am Partnerprogramm von STA Travel ist der Publisher verpflichtet, s\u00e4mtliche Werbemittel und Links von seiner Website unverz\u00fcglich zu entfernen. Sollte die K\u00fcndigung der Teilnahme des Publishers am Partnerprogramm von STA Travel durch einen Versto\u00df des Publishers gegen diese Teilnahmebedingungen verursacht worden sein, beh\u00e4lt sich STA Travel neben weiteren rechtlichen Schritten und der Geltendmachung von Schadensersatzanspr\u00fcchen vor, alle offenen Sales\/Leads zu stornieren.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">1.6 STA Travel beh\u00e4lt sich das Recht vor, das Partnerprogramm unter Einhaltung einer angemessenen Frist ohne Angaben von Gr\u00fcnden zu beenden und\/oder durch ein anderes Programm zu ersetzen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">2. Werbemittel und Werbeschaltung<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.1 Grundlegendes zur Werbeschaltung f\u00fcr STA Travel<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">a. Der Publisher darf die von STA TRAVEL zur Verf\u00fcgung gestellten Werbemittel ausschlie\u00dflich auf der Website verwenden, die er im Rahmen der Anmeldung zum STA TRAVEL Partnerprogramm angegeben hat und von STA Travel zugelassen wurde. Werbung f\u00fcr STA TRAVEL auf anderen als durch die Zulassung genehmigten Seiten, Fl\u00e4chen oder Werbeprogrammen ist nur nach schriftlicher Best\u00e4tigung durch STA TRAVEL zul\u00e4ssig.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b. S\u00e4mtliche von STA TRAVEL bereitgestellte Werbemittel d\u00fcrfen nur in unver\u00e4nderter Form integriert werden. \u00c4nderungen an Texten oder Bildern oder das Hinzuf\u00fcgen von eigenen Werbeaussagen oder Bildern sind nicht zul\u00e4ssig. Die Verwendung der Werbemittel von STA TRAVEL und\/oder der Marke(n), Namen, Logos, Angebote als Text oder Bild von STA TRAVEL in der eigenen Werbeschaltung des Publishers f\u00fcr seine Website oder f\u00fcr Websites Dritter oder f\u00fcr Produkte oder Services des Publishers oder Dritter ist dem Publisher untersagt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">c. Mit der Einbindung der entsprechenden Werbemittel auf der Website verpflichtet sich der Publisher zur Einhaltung dieser Teilnahmebedingungen sowie ggf. besonderer Vorgaben f\u00fcr die Einbindung des jeweiligen Werbemittels und garantiert, dass seine Website und die Werbet\u00e4tigkeiten insgesamt (i) keine Rechte Dritter (insbesondere Urheber-, Marken-, Pers\u00f6nlichkeits- oder vergleichbare Rechte) verletzen und\/oder (ii) nicht gegen sonstige gesetzliche, insbesondere wettbewerbs- und datenschutzrechtliche Bestimmungen versto\u00dfen und nicht staatsgef\u00e4hrdender, rassistischer, Gewalt verherrlichender, pornographischer oder jugendgef\u00e4hrdender Natur sind oder nicht \u00f6ffentlich zug\u00e4nglich gemacht werden d\u00fcrfen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">d. Der Publisher darf zur Bewerbung grunds\u00e4tzlich nur Werbemittel verwenden, welche zum Partnerprogramm zugelassen sind. STA TRAVEL ist jederzeit berechtigt, Werbemittel auszutauschen und durch neue zu ersetzen. Der Publisher verpflichtet sich zur unverz\u00fcglichen Umsetzung.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">e. Der Publisher darf nicht den Eindruck erwecken als k\u00f6nnte er STA TRAVEL im Rechtsverkehr vertreten bzw. Erkl\u00e4rungen gegen\u00fcber Dritten f\u00fcr STA TRAVEL abgeben und\/oder entgegennehmen. Der Publisher ist nicht berechtigt, Angebote im Namen von STA TRAVEL zur erstellen oder anzunehmen. Er ist an der Abwicklung der Vertr\u00e4ge zwischen STA TRAVEL und dem Endkunden nicht beteiligt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">f. STA TRAVEL kann jederzeit nach billigem Ermessen vom Publisher verlangen, dass dieser die Werbemittel unverz\u00fcglich und vollst\u00e4ndig von Werbefl\u00e4chen entfernt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">2.2. Ohne vorherige schriftliche Zustimmung von STA TRAVEL darf der Publisher nicht mit STA TRAVEL als Referenz werben.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">3. Werberichtlinien f\u00fcr besondere Marketingma\u00dfnahmen<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.1 SEA<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">a. Der Publisher darf die Marken STA Travel bzw. die Domain statravel.de nicht als Keyword, im Anzeigentext oder als Bestandteil der Display-URL verwenden. Dies gilt ebenso f\u00fcr s\u00e4mtliche Falschschreibweisen sowie Vertipper. Eine Kombination der Marken STA Travel mit weiteren Keywords wie Gutschein, Coupon, etc. ist ebenfalls nicht zugelassen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b. Eine direkte Verlinkung auf die Website statravel.de ist nicht gestattet. In jedem Fall muss eine f\u00fcr den Besucher sichtbare eigene Landingpage des Publishers genutzt werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">c. Um Irritationen vorzubeugen, m\u00fcssen die o.g. Marken-Keywords kontoweit generell auf \u201enegative phrase\u201c gesetzt werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.2 SEO-Ma\u00dfnahmen<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Der Publisher darf keine expliziten Ma\u00dfnahmen durchf\u00fchren, welche dazu dienen, in den organischen Suchergebnissen zu den Marken STA Travel (inkl. Schreibvarianten sowie Fehlschreibweisen) h\u00f6her gerankt zu werden, als die STA Travel Website. Dies gilt gleichfalls f\u00fcr Suchen in Kombination mit STA Travel<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.3 E-Mail<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">a. E-Mail Marketing ist nur nach vorheriger schriftlicher Zustimmung durch STA TRAVEL gestattet. STA TRAVEL kann die Zustimmung ohne Begr\u00fcndung versagen, ein Anspruch auf Zustimmung besteht nicht.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b. F\u00fcr das STA TRAVEL Partnerprogramm genutzte E-Mail Verteiler m\u00fcssen unter Beachtung der gesetzlichen Vorgaben, insbesondere aller ma\u00dfgeblichen wettbewerbs- und datenschutzrechtlichen Vorschriften und verbraucherrechtlichen Informationspflichten, der aktuellen Rechtsprechung und per Double Opt In (DOI) generiert worden sein. Zudem m\u00fcssen die Empf\u00e4nger dem Versand von Werbung an deren E-Mail Adresse ausdr\u00fccklich zugestimmt und nicht widersprochen haben. Der Publisher muss sicherstellen, dass er als Absender und Verantwortlicher der E-Mail eindeutig erkennbar ist.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">c. Bindet der Publisher ein STA TRAVEL Werbemittel in eine E-Mail ein, muss er das Werbemittel in Abgrenzung zum redaktionellen Inhalt als \u201eWerbung\u201c oder \u201eAnzeige\u201c kenntlich machen. Der Publisher gew\u00e4hrleistet, dass beim Empf\u00e4nger nicht der Eindruck entstehen kann, Absender oder Auftraggeber der E-Mail sei STA TRAVEL .<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.4 Gutscheine<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">a. Die Bewerbung von STA TRAVEL auf Websites mit einem klaren Fokus auf Coupon-und Gutschein-Vermittlungen ist nicht gestattet.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b. Es d\u00fcrfen keine Gutscheine bzw. Gutscheincodes beworben werden, welche nicht im Partnerprogramm von STA TRAVEL angeboten werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">c. Sofern STA Travel im Partnerprogramm Gutscheine bzw. Gutscheincodes anbietet und der Partner diese bewirbt, muss er s\u00e4mtliche von STA TRAVEL vorgegebene Konditionen (Laufzeit, Einschr\u00e4nkungen etc.) des Gutscheins kommunizieren und sicherstellen, dass die diesem Gutschein zugeordnete Werbemittel-ID\/Verlinkung korrekt verwendet wird.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">d. F\u00fcr die Bewerbung von Gutscheinseiten per SEA gelten die Bestimmungen unter Punkt 3.1 e. Die Bewerbung von Gutscheinen per iframe ist nicht zul\u00e4ssig. Das Setzen eines Cookies darf nur durch Klick des Users auf ein Werbemittel auf der Seite des Publishers erfolgen, welches nach dem Klick direkt auf die Seite von STA TRAVEL weiterleitet.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">f. Sofern exklusive Gutscheine an einzelne Publisher vergeben werden, d\u00fcrfen diese nur auf den von STA TRAVEL freigegebenen Seiten verwendet werden. Die Verwendung eines exklusiven Gutscheins eines Publishers durch einen Dritten hat den Ausschluss aus dem Partnerprogramm sowie die Stornierung der Sales\/Leads im Zusammenhang mit dieser Werbema\u00dfnahme zur Folge.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.5 Cashback- u. Bonussysteme<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">a. Die Bewerbung von STA TRAVEL auf Cashback-u. Bonusportalen ist nur nach vorheriger schriftlicher Zustimmung durch STA TRAVEL gestattet. STA TRAVEL kann die Zustimmung ohne Begr\u00fcndung versagen, ein Anspruch auf Zustimmung besteht nicht.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b. Die Teilnahme ist ausschlie\u00dflich unter der Voraussetzung m\u00f6glich, dass es sich um eine Weiterempfehlungsprovision handelt. Weiterempfehlungsprovision bedeutet, dass der User die Verg\u00fctung auf die Buchung eines Freundes erh\u00e4lt, der \u00fcber den entsprechenden Link geworben wurde. Die Bewerbung von regul\u00e4rem Cashback ist nicht zugelassen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">c. Aus der Bewerbung muss klar ersichtlich sein, dass es sich NICHT um Cashback handelt, auch das Wort \u201eCashback\u201c darf keinesfalls im Zusammenhang mit der Bewerbung von STA TRAVEL verwendet werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.6 Meta-Netzwerke<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">a. Die Bewerbung von STA TRAVEL in Meta-Netzwerken ist nur nach vorheriger schriftlicher Zustimmung durch STA TRAVEL gestattet. STA TRAVEL kann die Zustimmung ohne Begr\u00fcndung versagen, ein Anspruch auf Zustimmung besteht nicht.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b. Der Publisher tr\u00e4gt die Verantwortung daf\u00fcr, diese `Teilnahmebedingungen STA TRAVEL gegen\u00fcber seinen Sub-Publishern zu kommunizieren und deren Einhaltung durchzusetzen und zu \u00fcberwachen. Der Publisher haftet f\u00fcr das Verhalten seiner Sub-Publisher und stellt STA TRAVEL von allen daraus resultierenden Anspr\u00fcchen frei.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">c. Der Publisher muss die \u00dcbergabe des Referrers\/Ursprungslinks des jeweiligen Sub-Publishers gew\u00e4hrleisten, so dass jederzeit die Herkunft des Traffics nachvollzogen werden kann.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">3.7 Retargeting \/ Remarketing<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">a. Die Bewerbung von STA TRAVEL durch Retargeting \/ Remarketing im Rahmen des Partnerprogrammes ist nur nach vorheriger schriftlicher Zustimmung durch STA TRAVEL gestattet. STA TRAVEL kann die Zustimmung ohne Begr\u00fcndung versagen, ein Anspruch auf Zustimmung besteht nicht.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b. Der Publisher tr\u00e4gt die Verantwortung daf\u00fcr, diese `Teilnahmebedingungen STA TRAVEL Partnerprogramm` gegen\u00fcber seinen Partnern zu kommunizieren und deren Einhaltung durchzusetzen und zu \u00fcberwachen. Der Publisher haftet f\u00fcr das Verhalten seiner Partner und stellt STA TRAVEL von allen daraus resultierenden Anspr\u00fcchen frei.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">c. Der Publisher muss die \u00dcbergabe des Referrers\/Ursprungslinks des jeweiligen Sub-Publishers gew\u00e4hrleisten, so dass jederzeit die Herkunft des Traffics nachvollzogen werden kann.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">d. Der Einsatz eines Frequency Cappings muss gew\u00e4hrleistet sein, so dass die Steuerung entsprechend m\u00f6glich ist. Das Frequency Capping darf nicht mehr als zehn Einblendungen am Tag und nicht mehr als 20 Mal insgesamt betragen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">4. Nutzungsrechte<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4.1 Die im Rahmen der Teilnahme am STA TRAVEL Partnerprogramm erlangten Informationen und Daten d\u00fcrfen nur im Zusammenhang mit der Nutzung des STA TRAVEL Partnerprogramms verwendet werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4.2 Die zur Verf\u00fcgung gestellten Werbemittel und deren Quelltexte d\u00fcrfen nicht ohne vorherige Zustimmung von STA TRAVEL optisch, inhaltlich oder technisch ver\u00e4ndert oder anderweitig bearbeitet werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4.3 STA TRAVEL r\u00e4umt dem Publisher das jederzeit widerrufliche, nicht ausschlie\u00dfliche und nicht \u00fcbertragbare Recht ein, die im Rahmen des STA TRAVEL Partnerprogramms zur Verf\u00fcgung gestellten Werbemittel sowie die darin enthaltenen Daten unter Beachtung der allgemeinen Gesetze ausschlie\u00dflich im Rahmen der Teilnahme am STA TRAVEL Partnerprogramm zu nutzen. Mit Beendigung der Teilnahme am STA TRAVEL Partnerprogramm, ungeachtet des Grundes, erl\u00f6schen die vorgenannten Nutzungsrechte.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">4.4 Weitere Nutzungsrechte werden dem Publisher nicht einger\u00e4umt. Der Publisher ist insbesondere nicht berechtigt, die ihm zur Verf\u00fcgung gestellten Werbemittel sowie die darin enthaltenen Daten ganz oder teilweise an Dritte weiterzuleiten oder Dritten den Zugang hierzu zu erm\u00f6glichen, zu \u00e4ndern oder sonst wie zu bearbeiten, in andere Werkformen zu \u00fcbertragen oder zur Erstellung einer eigenen Datenbank und\/oder eines Informationsdienstes zu nutzen.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">5. Haftung<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.1 Verst\u00f6\u00dft der Publisher gegen die Teilnahmebedingungen und\/oder andere Gesetze bzw. Verordnungen und wird STA TRAVEL aufgrund dessen von einem Dritten rechtlich in Anspruch genommen, ist STA TRAVEL berechtigt, vom Publisher die Zahlung s\u00e4mtlicher Kosten und Aufw\u00e4nde (einschlie\u00dflich der Kosten der Rechtsverteidigung) zu verlangen, die STA TRAVEL aufgrund des Versto\u00dfes entstehen. Hierzu z\u00e4hlen insbesondere Schadens- oder Aufwendungsersatzzahlungen an Dritte zur Abwehr von Anspr\u00fcchen Dritter und sonstige Sch\u00e4den. Unbeschadet gesetzlicher Unterlassungs-, Schadensersatz- und sonstiger Anspr\u00fcche steht STA TRAVEL f\u00fcr jeden Fall der Zuwiderhandlung des Publishers gegen das Wettbewerbs-, Urheber-, Namens- oder Markenrecht eine Vertragsstrafe in H\u00f6he von 5.000 EUR von diesem zu.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.2 STA TRAVEL ist f\u00fcr den Inhalt von Websites Dritter, f\u00fcr Sch\u00e4den oder sonstige St\u00f6rungen, die auf der Fehlerhaftigkeit oder Inkompatibilit\u00e4t von Software oder Hardware der Teilnehmer beruhen, sowie f\u00fcr Sch\u00e4den, die auf Grund der mangelnden Verf\u00fcgbarkeit oder der Funktionsweise des Internets entstanden sind, nicht verantwortlich.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.3 Im \u00dcbrigen haftet STA TRAVEL gleich aus welchem Rechtsgrunde nur<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">a. bei Vorsatz und grober Fahrl\u00e4ssigkeit eines gesetzlichen Vertreters eines leitenden Angestellten oder sonstigen Erf\u00fcllungsgehilfen,<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">b. dem Grunde nach bei jeder schuldhaften Verletzung einer wesentlichen Vertragspflicht (wobei der Begriff der wesentlichen Vertragspflicht abstrakt eine solche Pflicht bezeichnet, deren Erf\u00fcllung die ordnungsgem\u00e4\u00dfe Durchf\u00fchrung des Vertrages \u00fcberhaupt erst erm\u00f6glicht und auf deren Einhaltung die jeweils andere Partei regelm\u00e4\u00dfig vertrauen darf), bei Verzug und Unm\u00f6glichkeit.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.4 Die Haftung nach Ziff. 5.3 ist bei Verm\u00f6gens- und Sachsch\u00e4den auf die H\u00f6he des typischerweise vorhersehbaren Schadens begrenzt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">5.5 Die vorgenannten Haftungsbeschr\u00e4nkungen gelten nicht in den F\u00e4llen zwingender gesetzlicher Haftung, insbesondere nach dem Produkthaftungsgesetz, bei \u00dcbernahme einer Garantie sowie bei schuldhaften Verletzungen des Lebens, des K\u00f6rpers und der Gesundheit.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">6. \u00c4nderung der Teilnahmebedingungen<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">STA TRAVEL beh\u00e4lt sich das Recht vor, diese Teilnahmebedingungen jederzeit ganz oder teilweise mit Wirkung f\u00fcr die Zukunft zu \u00e4ndern, sofern dies dem billigen Ermessen von STA TRAVEL entspricht und es f\u00fcr den Publisher zumutbar ist. \u00c4nderungen oder Erg\u00e4nzungen dieser Bedingungen werden durch Benachrichtigung mindestens in Textform bekannt gegeben. Sie gelten als genehmigt, wenn der Publisher nicht innerhalb von zwei Wochen 8 mindestens in Textform Widerspruch einlegt. Auf diese Folge wird bei Bekanntgabe besonders hingewiesen. Widerspricht der Publisher der \u00c4nderung, so kann seine Teilnahme am Partnerprogramm seitens STA TRAVEL durch ordentliche K\u00fcndigung gem\u00e4\u00df Ziffer 1.5 beendet werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">7. Schlussbestimmungen<\/span><\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">7.1 Rechte und Pflichten aus diesem Vertrag k\u00f6nnen nur mit der Zustimmung von STA TRAVEL \u00fcbertragen werden.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">7.2 Die Teilnahme am Partnerprogramm von STA TRAVEL erm\u00e4chtigt den Publisher nicht, f\u00fcr STA TRAVEL rechtsverbindliche Erkl\u00e4rungen abzugeben oder STA TRAVEL in sonstiger Weise zu verpflichten oder zu vertreten.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">7.3 Auf diese Teilnahmebedingungen und die Beziehung mit dem Publisher findet ausschlie\u00dflich das Recht der Bundesrepublik Deutschland unter Ausschluss des UN-Kaufrechts (CISG) Anwendung.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">7.4 Als Gerichtsstand gilt Frankfurt als vereinbart, sofern der Publisher Kaufmann i.S.d. Handelsgesetzbuchs (HGB) ist, keinen festen Wohnsitz in Deutschland hat, den festen Wohnsitz nach Wirksamwerden dieser AGB ins Ausland verlegt hat oder wenn der Wohnsitz oder gew\u00f6hnlicher Aufenthaltsort zum Zeitpunkt der Klageerhebung nicht bekannt sind.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">7.5 Soweit einzelne Klauseln dieser Teilnahmebedingungen ganz oder teilweise unwirksam sein sollten, bleibt die Wirksamkeit der \u00fcbrigen Bestimmungen davon unber\u00fchrt. Die unwirksame Bestimmung gilt als durch eine Bestimmung ersetzt, die \u00fcblicherweise dem Sinn und Zweck der unwirksamen Bestimmung in rechtswirksamer Weise wirtschaftlich am n\u00e4chsten kommt. Gleiches gilt f\u00fcr eventuelle Regelungsl\u00fccken.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Diese Teilnahmebedingungen gelten f\u00fcr das Partnerprogramm von STA Travel<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">STA Travel ist eine Marke der cockpit Flug &amp; Touristik Service GmbH, Am Hauptbahnhof 12, 60329 Frankfurt.<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Sitz der Gesellschaft:<\/span>&nbsp;Frankfurt am Main<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">Gesch\u00e4ftsf\u00fchrung:<\/span>&nbsp;Heike Niederberghaus<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\"><span style=\"margin: 0px; padding: 0px;\">USt.-ID:<\/span>&nbsp;DE 118644955 | Eingetragen beim AG Frankfurt am Main unter HRB 124574<\/p><p style=\"margin-right: 0px; margin-bottom: 10px; margin-left: 0px; padding: 0px;\">Wir freuen uns auf eine erfolgreiche Zusammenarbeit! Ihr STA Travel Affiliate Team<\/p